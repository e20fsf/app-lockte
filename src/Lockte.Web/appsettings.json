{
  "ConnectionStrings": {
    "Lockte": "Server=(localdb)\\MSSQLLocalDB;Database=Lockte;Integrated Security=true;TrustServerCertificate=true"
  },
  "Auth": {
    "IdleTimeoutMinutes": 30
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Reports": {
    "PagePoolSize": 3,
    "BrowsersPath": "",
    "InstallBrowser": true,
    "WarmUpOnStart": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
