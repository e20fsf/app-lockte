@page "/Account/ChangePassword"
@attribute [Authorize(Policy = AuthPolicies.SignedIn)]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject AccountService Accounts
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>เปลี่ยนรหัสผ่าน — LOCKTE</PageTitle>

<h1>เปลี่ยนรหัสผ่าน</h1>
<p class="account-notice">@AccountClaims.DisplayNameOf(HttpContext.User) (@HttpContext.User.Identity?.Name)</p>

@if (mustChange)
{
    <p class="account-notice">รหัสผ่านนี้เป็นรหัสชั่วคราว กรุณาตั้งรหัสใหม่ก่อนใช้งาน</p>
}
@foreach (var e in errors)
{
    <p class="account-error" role="alert">@e</p>
}

<EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
    <DataAnnotationsValidator />
    <label for="current">รหัสผ่านปัจจุบัน</label>
    <InputText id="current" type="password" @bind-Value="Input.Current" autocomplete="current-password" autofocus />
    <ValidationMessage For="() => Input.Current" class="account-error" />

    <label for="new">รหัสผ่านใหม่ (อย่างน้อย 8 ตัว)</label>
    <InputText id="new" type="password" @bind-Value="Input.New" autocomplete="new-password" />
    <ValidationMessage For="() => Input.New" class="account-error" />

    <label for="confirm">พิมพ์รหัสผ่านใหม่อีกครั้ง</label>
    <InputText id="confirm" type="password" @bind-Value="Input.Confirm" autocomplete="new-password" />
    <ValidationMessage For="() => Input.Confirm" class="account-error" />

    <button type="submit">บันทึกรหัสผ่านใหม่</button>
</EditForm>

@if (!mustChange)
{
    <p class="account-hint"><a href="@AccountClaims.HomeHref(HttpContext.User)">กลับ</a></p>
}
else
{
    <form action="Account/Logout" method="post" class="account-hint">
        <AntiforgeryToken />
        <button type="submit" class="link-button">ออกจากระบบ</button>
    </form>
}

@code {
    private bool mustChange;
    private IReadOnlyList<string> errors = [];

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        mustChange = AccountClaims.MustChange(HttpContext.User);
    }

    private async Task ChangeAsync()
    {
        var userId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!;
        var result = await Accounts.ChangePasswordAsync(userId, Input.Current, Input.New);
        if (!result.Succeeded)
        {
            errors = result.Errors;
            return;
        }

        // New cookie: without the must-change flag and with the new security stamp.
        var user = (await Accounts.FindAsync(userId))!;
        await SignInManager.RefreshSignInAsync(user);
        Navigation.NavigateTo(AccountsRegistration.HomeEndpoint);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "กรุณากรอกรหัสผ่านปัจจุบัน")]
        public string Current { get; set; } = "";

        [Required(ErrorMessage = "กรุณากรอกรหัสผ่านใหม่")]
        public string New { get; set; } = "";

        [Compare(nameof(New), ErrorMessage = "รหัสผ่านใหม่สองช่องไม่ตรงกัน")]
        public string Confirm { get; set; } = "";
    }
}
