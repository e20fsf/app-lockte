@page "/hr/resignation"
@attribute [Authorize]
@using Lockte.Hr
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* SCR-33 บันทึกการลาออกและพิมพ์ใบลาออก (ฟอร์ม รหัสพนักงาน2, BR-044): รหัส, วันที่ลาออก, เหตุผล → "บันทึกการลาออก"
   writes วันลาออก and หมายเหตุ; "พิมพ์" opens the ใบลาออก (RPT-55) with the date and reason as typed; "พิมพ์รายงาน
   พนักงานที่ลาออก" opens RPT-55's list. Choosing someone who already resigned fills in what was saved. *@
<PageTitle>บันทึกการลาออกและพิมพ์ใบลาออก — LOCKTE</PageTitle>
<h1 class="mb-4">บันทึกการลาออกและพิมพ์ใบลาออก</h1>

<MudPaper Class="pa-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <EmployeePicker Value="employee" ValueChanged="SelectAsync" />
        <MudDatePicker Editable="true" @bind-Date="resignDate" Label="วันที่ลาออก" Culture="ThaiDate.Culture"
                       DateFormat="@ThaiDate.Pattern" Style="max-width:12rem" />
        <MudTextField @bind-Value="reason" Label="เหตุผล" MaxLength="ResignationRegistry.ReasonLength" Style="min-width:20rem" />
    </MudStack>
    <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(employee is null || busy)">บันทึกการลาออก</MudButton>
        <MudButton Variant="Variant.Outlined" Disabled="employee is null" Target="_blank" Href="@LetterLink"
                   StartIcon="@Icons.Material.Filled.Print">พิมพ์</MudButton>
        <MudButton Variant="Variant.Outlined" Target="_blank" Href="reports/hr/resigned"
                   StartIcon="@Icons.Material.Filled.Assessment">พิมพ์รายงานพนักงานที่ลาออก</MudButton>
    </MudStack>
</MudPaper>

<MudButton Href="@EmployeeMenu.HrefOf(18)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private EmployeeListItem? employee;
    private EmployeeDto? loaded;
    private DateTime? resignDate;
    private string? reason;
    private bool busy;

    private string? LetterLink => employee is null
        ? null
        : $"reports/hr/resignation-letter/{employee.Id}?date={resignDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}&reason={Uri.EscapeDataString(reason ?? "")}";

    private async Task SelectAsync(EmployeeListItem? value)
    {
        employee = value;
        loaded = value is null ? null : await Services.RunAsync<EmployeeDirectory, EmployeeDto?>(d => d.GetAsync(value.Id));
        resignDate = loaded?.ResignDate?.ToDateTime(TimeOnly.MinValue);
        reason = loaded?.ResignDate is null ? null : loaded.Memo;
    }

    private async Task SaveAsync()
    {
        if (employee is null || loaded is null) return;
        busy = true;
        try
        {
            var date = resignDate is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;
            var id = employee.Id;
            var version = loaded.RowVersion;
            var result = await Services.RunAsync<ResignationRegistry, ServiceResult>(r => r.ResignAsync(id, date, reason, version));
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (result.Succeeded) Snackbar.Add("บันทึกการลาออกแล้ว", Severity.Success);
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            busy = false;
            loaded = await Services.RunAsync<EmployeeDirectory, EmployeeDto?>(d => d.GetAsync(employee.Id));
        }
    }
}
