@page "/hr/time/entry"
@attribute [Authorize]
@using Lockte.Hr
@using Lockte.Org
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* SCR-12 บันทึกเวลาทำงาน, OT, วันอาทิตย์และวันหยุด (ฟอร์ม E_WORK + E_WORK subform1): วันที่ on top, a row to key
   (รหัส เวลาเริ่ม เวลาเลิก เวลาพัก ประเภท), and the day's rows below — click one to edit or delete it. Rows go straight
   into เวลาทำงาน (BR-013): as the legacy (⚠ kept) no check for repeats or against the holiday calendar; the page only
   shows วันหยุด so HR sees it. A blank row is never saved (instead of BR-051's delete on "รายการต่อไป"/close), and
   there is no E_WORK_A backup copy on close (one table, #41). *@
<PageTitle>บันทึกเวลาทำงาน, OT, วันอาทิตย์และวันหยุด — LOCKTE</PageTitle>
<h1 class="mb-4">บันทึกเวลาทำงาน, OT, วันอาทิตย์และวันหยุด</h1>

<MudPaper Class="pa-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudDatePicker Editable="true" Date="day" DateChanged="DayChangedAsync" Label="วันที่" Culture="ThaiDate.Culture"
                       DateFormat="@ThaiDate.Pattern" Style="max-width:12rem" />
        <MudText>@Day.ToString("dddd", ThaiDate.Culture)</MudText>
        @if (dayOff is not null)
        {
            <MudChip T="string" Color="Color.Info" Size="Size.Small">@dayOff</MudChip>
        }
    </MudStack>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">@(form.Id is null ? "เพิ่มรายการ" : "แก้รายการที่เลือก")</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudAutocomplete T="EmployeeListItem" @bind-Value="form.Employee" Label="รหัส (รหัส หรือ ชื่อ)"
                         SearchFunc="SearchAsync" ToStringFunc="@(e => e is null ? "" : $"{e.Code}  {e.Name}")"
                         Clearable="true" ResetValueOnEmptyText="true" MaxItems="50" Style="min-width:20rem" />
        <TimeBox @bind-Text="form.WorkIn" Label="เวลาเริ่ม" Choices="startChoices" Style="max-width:8rem" />
        <TimeBox @bind-Text="form.WorkOut" Label="เวลาเลิก" Choices="endChoices" Style="max-width:8rem" />
        <MudSelect T="int" @bind-Value="form.RestMinutes" Label="เวลาพัก (นาที)" Style="max-width:8rem">
            @foreach (var m in ShiftDto.RestMinuteChoices)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="form.Type" Label="ประเภท" Style="max-width:7rem">
            @foreach (var t in WorkTypes.Codes)
            {
                <MudSelectItem T="string" Value="t">@t</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy">บันทึก</MudButton>
        @if (form.Id is not null)
        {
            <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="busy">ลบรายการนี้</MudButton>
        }
        <MudButton OnClick="New">รายการต่อไป</MudButton>
    </MudStack>

    <MudTable Items="rows" Dense="true" Hover="true" Class="mt-4" T="WorkTimeDto" Height="28rem" FixedHeader="true"
              OnRowClick="@((TableRowClickEventArgs<WorkTimeDto> e) => Edit(e.Item!))">
        <HeaderContent>
            <MudTh>รหัส</MudTh><MudTh>ชื่อ-นามสกุล</MudTh><MudTh>เวลาเริ่ม</MudTh><MudTh>เวลาเลิก</MudTh>
            <MudTh>เวลาพัก</MudTh><MudTh>ประเภท</MudTh><MudTh Style="text-align:right">WORK_T</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EmployeeCode</MudTd>
            <MudTd>@context.EmployeeName</MudTd>
            <MudTd>@TimeText.Format(context.WorkIn)</MudTd>
            <MudTd>@TimeText.Format(context.WorkOut)@(context.CrossesMidnight ? " (+1)" : "")</MudTd>
            <MudTd>@context.RestMinutes</MudTd>
            <MudTd>@context.Type</MudTd>
            <MudTd Style="text-align:right">@TimeText.Number(context.WorkT)</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>ยังไม่มีเวลาทำงานในวันนี้</MudText></NoRecordsContent>
    </MudTable>
    <MudText Typo="Typo.caption">WORK_T: ประเภท W นับเป็นวัน (ตั้งแต่ 7.75 ชม. = 1 วัน) ประเภทอื่นนับเป็นชั่วโมง (BR-001)</MudText>
</MudPaper>

<MudButton Href="@EmployeeMenu.HrefOf(3)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private DateTime? day = DateTime.Today;
    private IReadOnlyList<TimeOnly> startChoices = [];
    private IReadOnlyList<TimeOnly> endChoices = [];
    private IReadOnlyList<WorkTimeDto> rows = [];
    private List<EmployeeListItem> employees = [];
    private RowForm form = new();
    private string? dayOff;
    private bool busy;

    private DateOnly Day => DateOnly.FromDateTime(day ?? DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        // เวลาเริ่ม/เลิก choices = T-SHIFT.O_IN / O_OUT (combos of the legacy form), and the shifts' own times for วันอาทิตย์/วันหยุด.
        var shifts = await Services.RunAsync<OrgDirectory, IReadOnlyList<ShiftDto>>(o => o.GetShiftsAsync());
        startChoices = shifts.SelectMany(s => new[] { s.OvertimeIn, s.WorkIn }).OfType<TimeOnly>().Distinct().Order().ToList();
        endChoices = shifts.SelectMany(s => new[] { s.OvertimeOut, s.WorkOut }).OfType<TimeOnly>().Distinct().Order().ToList();
        employees = (await Services.RunAsync<EmployeeDirectory, IReadOnlyList<EmployeeListItem>>(d => d.SearchAsync()))
            .Where(e => e.IsWorking).ToList();
        await ReloadAsync();
    }

    private async Task DayChangedAsync(DateTime? value)
    {
        day = value;
        New();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var date = Day;
        rows = await Services.RunAsync<WorkTimeDirectory, IReadOnlyList<WorkTimeDto>>(d => d.ListAsync(date));
        var calendar = await Services.RunAsync<CalendarDirectory, HolidayCalendar>(c => c.GetAsync(date, date));
        dayOff = calendar.IsPublicHoliday(date) ? $"วันหยุดประเพณี{(calendar.PublicHolidays[0].Name is { } n ? $" ({n})" : "")}"
            : calendar.IsWeeklyHoliday(date) ? "วันหยุดประจำสัปดาห์" : null;
    }

    private Task<IEnumerable<EmployeeListItem>> SearchAsync(string? text, CancellationToken _)
    {
        var term = text?.Trim();
        return Task.FromResult(string.IsNullOrEmpty(term)
            ? employees
            : employees.Where(e => e.Code.StartsWith(term, StringComparison.OrdinalIgnoreCase) || e.Name.Contains(term)));
    }

    /// <summary>รายการต่อไป: a new row that keeps the times, rest and type just keyed (the next person usually has the same).</summary>
    private void New() => form = new RowForm { WorkIn = form.WorkIn, WorkOut = form.WorkOut, RestMinutes = form.RestMinutes, Type = form.Type };

    private void Edit(WorkTimeDto row) => form = new RowForm
    {
        Id = row.Id, WorkIn = TimeText.Format(row.WorkIn), WorkOut = TimeText.Format(row.WorkOut), RestMinutes = row.RestMinutes,
        Type = row.Type, Late = row.Late, Mark = row.Mark, RowVersion = row.RowVersion,
        Employee = employees.FirstOrDefault(e => e.Id == row.EmployeeId) ?? new EmployeeListItem(row.EmployeeId, row.EmployeeCode, row.EmployeeName, null, false),
    };

    private Task SaveAsync()
    {
        if (!TimeText.TryParse(form.WorkIn, out var workIn) || !TimeText.TryParse(form.WorkOut, out var workOut))
        {
            Snackbar.Add("เวลาต้องเป็น ชั่วโมง:นาที เช่น 17:20", Severity.Error);
            return Task.CompletedTask;
        }
        // LATE and MARK are not on this form: an edited row keeps them.
        var input = new WorkTimeInput(form.Id, Day, form.Employee?.Id, form.Type, workIn, workOut, form.RestMinutes, form.Late, form.Mark, form.RowVersion);
        return RunAsync(r => r.SaveAsync(input), "บันทึกแล้ว");
    }

    private Task DeleteAsync() => RunAsync(r => r.DeleteAsync(form.Id!.Value, form.RowVersion!), "ลบแล้ว");

    private async Task RunAsync(Func<WorkTimeRegistry, Task<ServiceResult>> action, string done)
    {
        busy = true;
        try
        {
            var result = await Services.RunAsync(action);
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (!result.Succeeded) return;
            Snackbar.Add(done, Severity.Success);
            New();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            New();
        }
        finally
        {
            busy = false;
            await ReloadAsync();
        }
    }

    private sealed class RowForm
    {
        public int? Id { get; set; }
        public EmployeeListItem? Employee { get; set; }
        public string? WorkIn { get; set; }
        public string? WorkOut { get; set; }
        public int RestMinutes { get; set; }
        public string? Type { get; set; }
        public TimeOnly? Late { get; set; }
        public string? Mark { get; set; }
        public byte[]? RowVersion { get; set; }
    }
}
