@page "/hr/public-holidays"
@attribute [Authorize]
@using System.Globalization
@using Lockte.Hr
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* SCR-16 เพิ่มและแก้ไขวันหยุด (ฟอร์ม HOLIDAY): the list of วันหยุดประเพณี (วันที่, ชื่อวันหยุด) entered one row at a time.
   The date is required (decided instead of BR-051's "blank row is deleted"); a row is deleted on purpose with "ลบ",
   as the legacy datasheet allowed. *@
<PageTitle>เพิ่มและแก้ไขวันหยุด — LOCKTE</PageTitle>
<h1 class="mb-4">เพิ่มและแก้ไขวันหยุด</h1>

<MudSelect T="int?" @bind-Value="year" Label="ปี" Dense="true" Style="max-width:10rem" Class="mb-2">
    <MudSelectItem T="int?" Value="null">ทุกปี</MudSelectItem>
    @foreach (var y in years)
    {
        <MudSelectItem T="int?" Value="y">@(y + 543)</MudSelectItem>
    }
</MudSelect>

<MudTable Items="Shown" Dense="true" Hover="true" Loading="holidays is null" T="PublicHolidayDto"
          OnRowClick="@((TableRowClickEventArgs<PublicHolidayDto> e) => Edit(e.Item!))">
    <HeaderContent>
        <MudTh>วันที่</MudTh>
        <MudTh>วัน</MudTh>
        <MudTh>ชื่อวันหยุด</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@ThaiDate(context.Date)</MudTd>
        <MudTd>@context.Date.ToString("dddd", ThaiCulture)</MudTd>
        <MudTd>@context.Name</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>ยังไม่มีวันหยุดประเพณี</MudText></NoRecordsContent>
</MudTable>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">@(form.Id is null ? "เพิ่มวันหยุด" : $"แก้วันหยุด {ThaiDate(form.LoadedDate!.Value)}")</MudText>
        <MudSpacer />
        <MudButton OnClick="New" StartIcon="@Icons.Material.Filled.Add">รายการใหม่</MudButton>
    </MudStack>
    <MudGrid Spacing="2">
        <MudItem xs="6" sm="3">
            <MudDatePicker @bind-Date="form.Date" Label="วันที่" Culture="ThaiCulture" DateFormat="d/M/yyyy" Editable="true" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="form.Name" Label="ชื่อวันหยุด" MaxLength="HolidayRegistry.PublicHolidayNameLength" />
        </MudItem>
    </MudGrid>
    <MudStack Row="true" Spacing="2" Class="mt-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy">บันทึก</MudButton>
        @if (form.Id is not null)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync" Disabled="busy"
                       StartIcon="@Icons.Material.Filled.Delete">ลบ</MudButton>
        }
    </MudStack>
</MudPaper>

<MudButton Href="@EmployeeMenu.HrefOf(7)" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">
    กลับเมนูเดิม
</MudButton>

@code {
    private static readonly CultureInfo ThaiCulture = new("th-TH");

    private IReadOnlyList<PublicHolidayDto>? holidays;
    private IReadOnlyList<int> years = [];
    private int? year = DateTime.Today.Year;
    private PublicHolidayForm form = new();
    private bool busy;

    private IEnumerable<PublicHolidayDto> Shown => (holidays ?? []).Where(h => year is null || h.Date.Year == year);

    private static string ThaiDate(DateOnly date) => date.ToString("d/M/yyyy", ThaiCulture);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        holidays = await Services.RunAsync<HolidayCalendar, IReadOnlyList<PublicHolidayDto>>(c => c.GetPublicHolidaysAsync());
        years = holidays.Select(h => h.Date.Year).Append(DateTime.Today.Year).Distinct().Order().ToList();
    }

    private void New() => form = new PublicHolidayForm();

    private void Edit(PublicHolidayDto h) => form = new PublicHolidayForm
    {
        Id = h.Id, Date = h.Date.ToDateTime(TimeOnly.MinValue), LoadedDate = h.Date, Name = h.Name, RowVersion = h.RowVersion,
    };

    private Task SaveAsync() => RunAsync(async () =>
    {
        var input = new PublicHolidayInput(form.Id, form.Date is { } d ? DateOnly.FromDateTime(d) : null, form.Name, form.RowVersion);
        var result = await Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.SavePublicHolidayAsync(input));
        if (!Report(result, "บันทึกแล้ว")) return;
        await ReloadAsync();
        if (holidays!.FirstOrDefault(h => h.Id == result.Id) is { } saved) Edit(saved); else New();
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        int id = form.Id!.Value;
        byte[] rowVersion = form.RowVersion!;
        var result = await Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.DeletePublicHolidayAsync(id, rowVersion));
        if (!Report(result, "ลบแล้ว")) return;
        await ReloadAsync();
        New();
    });

    private bool Report(ServiceResult result, string success)
    {
        foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
        if (result.Succeeded) Snackbar.Add(success, Severity.Success);
        return result.Succeeded;
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        try
        {
            await action();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await ReloadAsync();
            New();
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class PublicHolidayForm
    {
        public int? Id { get; set; }
        public DateTime? Date { get; set; }
        public DateOnly? LoadedDate { get; set; }
        public string? Name { get; set; }
        public byte[]? RowVersion { get; set; }
    }
}
