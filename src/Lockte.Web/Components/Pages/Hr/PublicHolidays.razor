@page "/hr/public-holidays"
@attribute [Authorize]
@using Lockte.Hr
@using Lockte.SharedKernel
@inject ScopedServices Services

@* SCR-16 เพิ่มและแก้ไขวันหยุด (ฟอร์ม HOLIDAY, หัวฟอร์ม "เพิ่มและแก้ไขวันหยุดประจำปี"): วันหยุดประเพณี (วันที่, ชื่อวันหยุด)
   edited one row at a time in place, in date order. The date is required (decided instead of BR-051's "blank row is
   deleted"); a row is deleted on purpose with its own button. *@
<PageTitle>เพิ่มและแก้ไขวันหยุด — LOCKTE</PageTitle>
<h1 class="mb-4">เพิ่มและแก้ไขวันหยุด</h1>

<HolidayYearFilter Years="@((holidays ?? []).Select(h => h.Date.Year))" Year="year" YearChanged="ShowYear" />

@if (holidays is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <HolidayRows Rows="rows" TextLabel="ชื่อวันหยุด" TextMaxLength="HolidayRegistry.PublicHolidayNameLength"
                 Save="SaveAsync" Delete="DeleteAsync" Changed="ReloadAsync" />
}

<BackToMenu Code="SCR-16" />

@code {
    private IReadOnlyList<PublicHolidayDto>? holidays;
    private IReadOnlyList<HolidayRow> rows = [];
    private int? year = DateTime.Today.Year;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void ShowYear(int? shown)
    {
        year = shown;
        Filter();
    }

    private async Task ReloadAsync()
    {
        holidays = await Services.RunAsync<HolidayCalendar, IReadOnlyList<PublicHolidayDto>>(c => c.GetPublicHolidaysAsync());
        Filter();
    }

    private void Filter() => rows = (holidays ?? []).Where(h => year is null || h.Date.Year == year)
        .Select(h => new HolidayRow(h.Id, h.Date, h.Name, h.RowVersion)).ToList();

    private Task<ServiceResult> SaveAsync(HolidayRow row)
    {
        var input = new PublicHolidayInput(row.Id, row.DateOnly, row.Text, row.RowVersion);
        return Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.SavePublicHolidayAsync(input));
    }

    private Task<ServiceResult> DeleteAsync(HolidayRow row)
        => Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.DeletePublicHolidayAsync(row.Id!.Value, row.RowVersion!));
}
