@page "/hr/calendar/holidays"
@attribute [Authorize]
@using System.Globalization
@using Lockte.Hr
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* SCR-16 เพิ่มและแก้ไขวันหยุด (ฟอร์ม HOLIDAY): DATE + ITEM (ชื่อวันหยุด) one row at a time. A date is required —
   a blank row is never saved (instead of BR-051's delete on close). Shown one year at a time. *@
<PageTitle>เพิ่มและแก้ไขวันหยุด — LOCKTE</PageTitle>
<h1 class="mb-4">เพิ่มและแก้ไขวันหยุด</h1>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
    <MudNumericField T="int" Value="year" ValueChanged="YearChangedAsync" Label="ปี (ค.ศ.)" Style="max-width:8rem" />
    <MudText Typo="Typo.body2">พ.ศ. @(year + 543)</MudText>
</MudStack>

<MudTable Items="rows" Dense="true" Hover="true" T="PublicHolidayDto" OnRowClick="@((TableRowClickEventArgs<PublicHolidayDto> e) => Edit(e.Item!))">
    <HeaderContent><MudTh>วันที่</MudTh><MudTh>วัน</MudTh><MudTh>ชื่อวันหยุด</MudTh></HeaderContent>
    <RowTemplate>
        <MudTd>@context.Date.ToString("d/M/yyyy", ThaiCulture)</MudTd>
        <MudTd>@context.Date.ToString("dddd", ThaiCulture)</MudTd>
        <MudTd>@context.Name</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>ไม่มีวันหยุดประเพณีในปีนี้</MudText></NoRecordsContent>
</MudTable>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">@(form.Id is null ? "เพิ่มวันหยุด" : "แก้วันหยุดที่เลือก")</MudText>
        <MudSpacer />
        <MudButton OnClick="New" StartIcon="@Icons.Material.Filled.Add">รายการใหม่</MudButton>
    </MudStack>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudDatePicker Editable="true" @bind-Date="form.Date" Label="วันที่" Culture="ThaiCulture" DateFormat="d/M/yyyy" Required="true" RequiredError="กรุณากรอกวันที่" Style="max-width:12rem" />
        <MudTextField @bind-Value="form.Name" Label="ชื่อวันหยุด" MaxLength="CalendarRegistry.HolidayNameLength" Style="min-width:20rem" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy">บันทึก</MudButton>
        @if (form.Id is not null)
        {
            <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="busy">ลบวันนี้</MudButton>
        }
    </MudStack>
</MudPaper>

<MudButton Href="@EmployeeMenu.HrefOf(7)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private static readonly CultureInfo ThaiCulture = new("th-TH");

    private int year = DateTime.Today.Year;
    private IReadOnlyList<PublicHolidayDto> rows = [];
    private RowForm form = new();
    private bool busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task YearChangedAsync(int value)
    {
        year = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
        => rows = (await Services.RunAsync<HrCalendar, HolidayCalendar>(c => c.GetAsync(new DateOnly(year, 1, 1), new DateOnly(year, 12, 31)))).PublicHolidays;

    private void New() => form = new RowForm();

    private void Edit(PublicHolidayDto row)
        => form = new RowForm { Id = row.Id, Date = row.Date.ToDateTime(TimeOnly.MinValue), Name = row.Name, RowVersion = row.RowVersion };

    private Task SaveAsync()
    {
        var input = new PublicHolidayInput(form.Id, form.Date is { } d ? DateOnly.FromDateTime(d) : null, form.Name, form.RowVersion);
        return RunAsync(r => r.SavePublicHolidayAsync(input), "บันทึกแล้ว");
    }

    private Task DeleteAsync() => RunAsync(r => r.DeletePublicHolidayAsync(form.Id!.Value, form.RowVersion!), "ลบแล้ว");

    private async Task RunAsync(Func<CalendarRegistry, Task<ServiceResult>> action, string done)
    {
        busy = true;
        try
        {
            var result = await Services.RunAsync(action);
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (!result.Succeeded) return;
            Snackbar.Add(done, Severity.Success);
            New();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            New();
        }
        finally
        {
            busy = false;
            await ReloadAsync();
        }
    }

    private sealed class RowForm
    {
        public int? Id { get; set; }
        public DateTime? Date { get; set; }
        public string? Name { get; set; }
        public byte[]? RowVersion { get; set; }
    }
}
