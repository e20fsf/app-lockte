@page "/hr/weekly-holidays"
@attribute [Authorize]
@using Lockte.Hr
@using Lockte.SharedKernel
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* SCR-15 เพิ่มและแก้ไขวันอาทิตย์ (ฟอร์ม SUNDAY): วันหยุดประจำสัปดาห์ (วันที่, ป้าย) edited one row at a time in place;
   "เพิ่ม" = four more weeks after each label's last date (BR-014); "ลบ" = every date in a range (ฟอร์ม ลบวันอาทิตย์).
   The date is required (decided instead of BR-051's "blank row is deleted"), so a blank row is never saved. *@
<PageTitle>เพิ่มและแก้ไขวันอาทิตย์ — LOCKTE</PageTitle>
<h1 class="mb-4">เพิ่มและแก้ไขวันอาทิตย์</h1>

<HolidayYearFilter Years="@((holidays ?? []).Select(h => h.Date.Year))" Year="year" YearChanged="ShowYear" />

@if (holidays is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <HolidayRows Rows="rows" TextLabel="ป้าย" TextMaxLength="HolidayRegistry.WeeklyLabelLength"
                 TextPlaceholder="@HolidayRegistry.DefaultWeeklyLabel" Save="SaveAsync" Delete="DeleteAsync" Changed="ReloadAsync" />
}

<MudStack Row="true" Spacing="2" Class="mt-2">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNextAsync" Disabled="busy">
        เพิ่ม @HolidayRegistry.WeeksPerAdd สัปดาห์
    </MudButton>
</MudStack>

<MudPaper Class="pa-4 mt-4" Outlined="true" Style="max-width:48rem">
    <MudText Typo="Typo.h6" Class="mb-2">ลบวันหยุดประจำสัปดาห์ตามช่วงวันที่</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="6"><MudDatePicker @bind-Date="deleteFrom" Label="ตั้งแต่วันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Format" Editable="true" /></MudItem>
        <MudItem xs="6"><MudDatePicker @bind-Date="deleteTo" Label="ถึงวันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Format" Editable="true" /></MudItem>
    </MudGrid>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteRangeAsync" Disabled="@(busy || deleteFrom is null || deleteTo is null)"
               Class="mt-2" StartIcon="@Icons.Material.Filled.Delete">ลบ</MudButton>
</MudPaper>

<BackToMenu Code="SCR-15" />

@code {
    private IReadOnlyList<WeeklyHolidayDto>? holidays;
    private IReadOnlyList<HolidayRow> rows = [];
    private int? year = DateTime.Today.Year;
    private DateTime? deleteFrom, deleteTo;
    private bool busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void ShowYear(int? shown)
    {
        year = shown;
        Filter();
    }

    private async Task ReloadAsync()
    {
        holidays = await Services.RunAsync<HolidayCalendar, IReadOnlyList<WeeklyHolidayDto>>(c => c.GetWeeklyHolidaysAsync());
        Filter();
    }

    private void Filter() => rows = (holidays ?? []).Where(h => year is null || h.Date.Year == year)
        .Select(h => new HolidayRow(h.Id, h.Date, h.Label, h.RowVersion)).ToList();

    private Task<ServiceResult> SaveAsync(HolidayRow row)
    {
        var input = new WeeklyHolidayInput(row.Id, row.DateOnly, row.Text, row.RowVersion);
        return Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.SaveWeeklyHolidayAsync(input));
    }

    private Task<ServiceResult> DeleteAsync(HolidayRow row)
        => Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.DeleteWeeklyHolidayAsync(row.Id!.Value, row.RowVersion!));

    private async Task AddNextAsync()
    {
        busy = true;
        try
        {
            var result = await Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.AddNextWeeklyHolidaysAsync());
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (!result.Succeeded) return;
            Snackbar.Add($"เพิ่มวันหยุดประจำสัปดาห์อีก {HolidayRegistry.WeeksPerAdd} สัปดาห์แล้ว", Severity.Success);
            await ReloadAsync();
            if (year is not null) year = holidays![^1].Date.Year; // show the year the new dates went into
            Filter();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteRangeAsync()
    {
        busy = true;
        try
        {
            DateOnly from = DateOnly.FromDateTime(deleteFrom!.Value), to = DateOnly.FromDateTime(deleteTo!.Value);
            var result = await Services.RunAsync<HolidayRegistry, ServiceResult>(r => r.DeleteWeeklyHolidaysAsync(from, to));
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (!result.Succeeded) return;
            Snackbar.Add("ลบแล้ว", Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
