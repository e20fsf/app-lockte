@page "/hr/certificates"
@attribute [Authorize]
@using Lockte.Hr

@* RPT-53 พิมพ์หนังสือรับรอง (ฟอร์ม วันทำงาน7, BR-070): choose the employee, then "การทำงาน" or "เงินเดือน" opens the
   letter as PDF in a new tab. *@
<PageTitle>พิมพ์หนังสือรับรอง — LOCKTE</PageTitle>
<h1 class="mb-4">พิมพ์หนังสือรับรอง</h1>

<MudPaper Class="pa-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <EmployeePicker @bind-Value="employee" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="employee is null" Target="_blank"
                   Href="@Link("work")" StartIcon="@Icons.Material.Filled.Print">การทำงาน</MudButton>
        <PayView>
            <ChildContent>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="employee is null" Target="_blank"
                       Href="@Link("salary")" StartIcon="@Icons.Material.Filled.Print">เงินเดือน</MudButton>
            </ChildContent>
            <NotAllowed><MudButton Variant="Variant.Filled" Disabled="true" StartIcon="@Icons.Material.Filled.Print">เงินเดือน</MudButton>
                <MudText Typo="Typo.caption">ไม่มีสิทธิ์ดูข้อมูลค่าจ้าง</MudText></NotAllowed>
        </PayView>
    </MudStack>
</MudPaper>

<MudButton Href="@EmployeeMenu.HrefOf(19)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private EmployeeListItem? employee;

    private string? Link(string kind) => employee is null ? null : $"reports/hr/certificate/{employee.Id}?kind={kind}";
}
