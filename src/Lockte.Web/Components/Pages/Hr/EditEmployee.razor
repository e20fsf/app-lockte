@page "/hr/employees"
@attribute [Authorize]
@using Lockte.Hr
@using Lockte.Org
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* SCR-03 แก้ไขข้อมูลพนักงาน (ฟอร์ม EMPLO1): ค้นหาพนักงาน → ข้อมูลพนักงาน (all fields of SCR-02 + วันลาออก, หมายเหตุ;
   ค่าแรง/วัน not rounded ⚠ BR-052) → สถิติ (BR-054), recomputed when the page opens and after each save.
   The legacy "ลบพนักงานที่ลาออก" button (BR-043) is not built: history is kept (#41). *@
<PageTitle>แก้ไขข้อมูลพนักงาน — LOCKTE</PageTitle>
<h1 class="mb-4">แก้ไขข้อมูลพนักงาน</h1>

<MudAutocomplete T="EmployeeListItem" Value="selected" ValueChanged="OpenAsync" Label="ค้นหาพนักงาน (รหัส หรือ ชื่อ)"
                 SearchFunc="SearchAsync" ToStringFunc="@(e => e is null ? "" : $"{e.Code}  {e.Name}")"
                 Clearable="true" ResetValueOnEmptyText="true" MaxItems="50" Class="mb-4" Style="max-width:32rem">
    <ItemTemplate>
        <MudText Color="@(context.IsWorking ? Color.Default : Color.Secondary)">
            @context.Code  @context.Name @(context.DepartmentName is { } d ? $"· {d}" : "") @(context.IsWorking ? "" : "(ลาออก)")
        </MudText>
    </ItemTemplate>
</MudAutocomplete>

@if (form is not null)
{
    <MudPaper Class="pa-4" Outlined="true">
        @if (loaded is { OnProbation: true })
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                ยังไม่ผ่านทดลองงาน · ครบ 90 วัน @loaded.NinetyDayDate?.ToString("d/M/yyyy", ThaiCulture) · ครบทดลองงาน @loaded.ProbationEndDate?.ToString("d/M/yyyy", ThaiCulture)
            </MudAlert>
        }
        <EmployeeFields Form="form" Departments="departments" Sections="sections" Shifts="shifts" Choices="choices" IsEdit="true" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy" Class="mt-4">บันทึก</MudButton>
    </MudPaper>
}

<MudText Typo="Typo.h6" Class="mt-6 mb-2">สถิติพนักงาน (ยังไม่ลาออก)</MudText>
@if (stats is not null)
{
    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudSimpleTable Dense="true" Bordered="true">
                <thead><tr><th>แผนก</th><th>ชาย</th><th>หญิง</th><th>รวม</th><th>อัตรา</th><th>รวม − อัตรา</th></tr></thead>
                <tbody>
                    @foreach (var r in stats.ByDepartment)
                    {
                        <tr><td style="white-space:nowrap">@r.DepartmentName</td><td>@r.Male</td><td>@r.Female</td><td>@r.Total</td><td>@r.StaffingTarget</td><td>@r.Difference</td></tr>
                    }
                    <tr><th>รวม</th><th>@stats.ByDepartment.Sum(r => r.Male)</th><th>@stats.ByDepartment.Sum(r => r.Female)</th><th>@stats.ByDepartment.Sum(r => r.Total)</th><th></th><th></th></tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudSimpleTable Dense="true" Bordered="true" Style="overflow-x:auto">
                <thead>
                    <tr><th>แผนก</th>@foreach (var level in EmployeeStatistics.EducationLevels) { <th>@level</th> }</tr>
                </thead>
                <tbody>
                    @foreach (var r in stats.ByEducation)
                    {
                        <tr><td style="white-space:nowrap">@r.DepartmentName</td>@foreach (var level in EmployeeStatistics.EducationLevels) { <td>@(r.Counts[level] == 0 ? "" : r.Counts[level])</td> }</tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudSimpleTable Dense="true" Bordered="true">
                <thead><tr><th>โรงพยาบาล</th><th>จำนวน</th></tr></thead>
                <tbody>
                    @foreach (var h in stats.ByHospital)
                    {
                        <tr><td>@h.Hospital</td><td>@h.Count</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudItem>
    </MudGrid>
}

<MudButton Href="@EmployeeMenu.HrefOf(2)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private static readonly System.Globalization.CultureInfo ThaiCulture = new("th-TH");

    private EmployeeListItem? selected;
    private EmployeeDto? loaded;
    private EmployeeFormModel? form;
    private IReadOnlyList<DepartmentDto> departments = [];
    private IReadOnlyList<SectionDto> sections = [];
    private IReadOnlyList<ShiftDto> shifts = [];
    private EmployeeChoices choices = new([], []);
    private EmployeeStatistics? stats;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        (departments, sections, shifts) = await Services.RunAsync<OrgDirectory, (IReadOnlyList<DepartmentDto>, IReadOnlyList<SectionDto>, IReadOnlyList<ShiftDto>)>(
            async d => (await d.GetDepartmentsAsync(), await d.GetSectionsAsync(), await d.GetShiftsAsync()));
        await ReloadSideDataAsync();
    }

    private Task<IEnumerable<EmployeeListItem>> SearchAsync(string? text, CancellationToken _)
        => Services.RunAsync<EmployeeDirectory, IEnumerable<EmployeeListItem>>(async d => await d.SearchAsync(text));

    private async Task OpenAsync(EmployeeListItem? item)
    {
        selected = item;
        loaded = item is null ? null : await Services.RunAsync<EmployeeDirectory, EmployeeDto?>(d => d.GetAsync(item.Id));
        form = loaded is null ? null : EmployeeFormModel.From(loaded);
    }

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var input = form!.ToInput();
            var result = await Services.RunAsync<EmployeeRegistry, ServiceResult>(r => r.SaveAsync(input));
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (!result.Succeeded) return;

            Snackbar.Add("บันทึกแล้ว", Severity.Success);
            await ReopenAsync(result.Id!.Value);
            await ReloadSideDataAsync();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await ReopenAsync(form!.Id!.Value);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReopenAsync(int id)
    {
        loaded = await Services.RunAsync<EmployeeDirectory, EmployeeDto?>(d => d.GetAsync(id));
        form = loaded is null ? null : EmployeeFormModel.From(loaded);
        selected = loaded is null ? null : new EmployeeListItem(loaded.Id, loaded.Code, loaded.Name, loaded.DepartmentName, loaded.IsWorking);
    }

    private async Task ReloadSideDataAsync()
    {
        choices = await Services.RunAsync<EmployeeDirectory, EmployeeChoices>(d => d.GetChoicesAsync());
        stats = await Services.RunAsync<EmployeeDirectory, EmployeeStatistics>(d => d.GetStatisticsAsync());
    }
}
