@page "/hr/employees/lists"
@attribute [Authorize]
@using Lockte.Hr
@using Lockte.Org
@using Lockte.Web.Reports.Hr
@inject ScopedServices Services
@inject IJSRuntime Js

@* SCR-04 เลือกแผนกที่พิมพ์ (BR-073): แผนก and กะ (blank = all, the legacy "*") → รายชื่อพนักงานแผนก… (RPT-21);
   ทะเบียนประวัติพนักงาน (everyone, whatever is chosen, as the legacy button). รายชื่อพนักงานทั้งหมด (report EMPLO) had no
   menu item in the legacy (⚠ เมนู 8); it is printed from here. Each report opens as a PDF in a new tab. *@
<PageTitle>พิมพ์รายชื่อพนักงาน — LOCKTE</PageTitle>
<h1 class="mb-4">พิมพ์รายชื่อพนักงาน</h1>

<MudPaper Class="pa-4" Outlined="true" Style="max-width:40rem">
    <MudStack Spacing="3">
        <MudSelect T="int?" @bind-Value="departmentId" Label="แผนก" Clearable="true" Placeholder="ทุกแผนก">
            @foreach (var d in departments.Where(x => x.IsActive))
            {
                <MudSelectItem T="int?" Value="d.Id">@d.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int?" @bind-Value="shiftId" Label="กะ" Clearable="true" Placeholder="ทุกกะ">
            @foreach (var s in ShiftChoices)
            {
                <MudSelectItem T="int?" Value="s.Id">@s.Code</MudSelectItem>
            }
        </MudSelect>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            @* รายชื่อแผนก (เงินเดือน/ค่าแรง) and ทะเบียนประวัติ (ค่าแรง) carry ข้อมูลค่าจ้าง (#277) *@
            <PayView>
                <ChildContent>
                @* #399: a แผนก / กะ nobody works in prints no empty "ไม่มีข้อมูล" PDF: the message is shown here instead *@
                <MudButton OnClick="() => OpenRosterAsync(false)" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Print">พิมพ์</MudButton>
                <MudButton OnClick="() => OpenRosterAsync(true)" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.TableView">ส่งออก Excel (รายชื่อแผนก)</MudButton>
                <MudButton Href="@($"{OnboardingReports.Base}/register")" Target="_blank" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Print">พิมพ์ทะเบียนประวัติพนักงาน</MudButton>
                <MudButton Href="@($"{OnboardingReports.Base}/register?current=true")" Target="_blank" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Print">พิมพ์ทะเบียนประวัติพนักงานที่มีอยู่ปัจจุบัน</MudButton>
                <MudButton Href="@($"{OnboardingReports.Base}/register?format=xlsx")" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.TableView">ส่งออก Excel (ทะเบียนประวัติ)</MudButton>
                <MudButton Href="@($"{OnboardingReports.Base}/register?current=true&format=xlsx")" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.TableView">ส่งออก Excel (ทะเบียนประวัติปัจจุบัน)</MudButton>
                </ChildContent>
                <NotAllowed><MudText Typo="Typo.caption">พิมพ์รายชื่อแผนกและทะเบียนประวัติไม่ได้ — ไม่มีสิทธิ์ดูข้อมูลค่าจ้าง</MudText></NotAllowed>
            </PayView>
            <MudButton Href="@($"{OnboardingReports.Base}/working")" Target="_blank" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Print">พิมพ์รายชื่อพนักงานทั้งหมด</MudButton>
            <MudButton Href="@($"{OnboardingReports.Base}/working?format=xlsx")" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.TableView">ส่งออก Excel (รายชื่อทั้งหมด)</MudButton>
        </MudStack>
        @if (emptyMessage is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@emptyMessage</MudAlert>
        }
        <MudButton Href="@EmployeeMenu.HrefOf(2)" StartIcon="@Icons.Material.Filled.ArrowBack" Style="align-self:flex-start">กลับเมนูเดิม</MudButton>
    </MudStack>
</MudPaper>

@code {
    private IReadOnlyList<DepartmentDto> departments = [];
    private IReadOnlyList<ShiftDto> shifts = [];
    private int? departmentId;
    private int? shiftId;
    private string? emptyMessage;

    private async Task OpenRosterAsync(bool excel)
    {
        var roster = await Services.RunAsync<OnboardingDirectory, DepartmentRoster>(d => d.GetDepartmentRosterAsync(departmentId, shiftId));
        if (roster.Lines.Count == 0)
        {
            emptyMessage = "ไม่มีพนักงานในแผนก/กะที่เลือก — ไม่มีข้อมูลให้พิมพ์";
            return;
        }
        emptyMessage = null;
        await Js.InvokeVoidAsync("open", OnboardingReports.RosterHref(departmentId, shiftId) + (excel ? "&format=xlsx" : ""), excel ? "_self" : "_blank");
    }

    /// <summary>The กะ the chosen แผนก works (the legacy dropdown listed แผนก + กะ pairs); every กะ when no แผนก is chosen.</summary>
    private IEnumerable<ShiftDto> ShiftChoices => departments.FirstOrDefault(d => d.Id == departmentId) is { } d
        ? shifts.Where(s => d.Shifts.Any(x => x.ShiftId == s.Id))
        : shifts;

    protected override async Task OnInitializedAsync()
        => (departments, shifts) = await Services.RunAsync<OrgDirectory, (IReadOnlyList<DepartmentDto>, IReadOnlyList<ShiftDto>)>(
            async o => (await o.GetDepartmentsAsync(), await o.GetShiftsAsync()));
}
