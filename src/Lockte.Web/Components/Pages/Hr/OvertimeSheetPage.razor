@page "/hr/time/overtime-sheet"
@attribute [Authorize]
@using Lockte.Hr
@using Lockte.Org
@using Lockte.SharedKernel
@using Lockte.Web.Reports.Hr
@inject ScopedServices Services
@inject OvertimeSheetPrints Prints
@inject IJSRuntime JS
@inject ISnackbar Snackbar

@* SCR-14 ใบขออนุมัติทำ OT (ฟอร์ม OT + subform OT1): วันที่ แผนก เวลาเริ่ม/เลิก เวลาพัก ประเภท for the whole sheet, then
   one line per employee — picking a รหัส fills ชื่อ and หมายเหตุ with the employee's หน้าที่, as the legacy. พิมพ์ saves a
   เวลาทำงาน row per new line (BR-012) and opens RPT-16 in a new tab. แก้ครั้งที่ 12: the table and the sheet are everyone working OT that
   day (OvertimeSheetRegistry.GetDayLinesAsync), in the แผนก chosen or ทุกแผนก, starting at the เวลาเข้า chosen or เวลาทั้งหมด; rows already
   saved show as "บันทึกแล้ว" and are never saved twice (the legacy would add the rows again). The legacy's หลายกะ (start the next
   ช่วงเวลา) is not a button any more: choosing another เวลาเข้า does it. People
   recorded ไม่มาทำงาน that day are marked, which is what the legacy's GRED_2 = "NO" flag was for (never cleared here). *@
<PageTitle>พิมพ์ใบขออนุมัติทำล่วงเวลา — LOCKTE</PageTitle>
<h1 class="mb-4">พิมพ์ใบขออนุมัติทำงานล่วงเวลา</h1>

<MudPaper Class="pa-4" Outlined="true">
    @* แก้ครั้งที่ 12: the day, แผนก and เวลาเข้า choose who the table and the sheet list; the times, rest and type below go with the people added. *@
    <MudGrid Spacing="2" Class="align-end">
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Editable="true" Date="day" DateChanged="DayChangedAsync" Label="@($"วันที่ทำ ({Day.ToString("dddd", ThaiDate.Culture)})")"
                           Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" />
        </MudItem>
        <MudItem xs="12" sm="4" md="5">
            <MudSelect T="int?" Value="departmentId" ValueChanged="DepartmentChangedAsync" Label="แผนก" ToStringFunc="DepartmentText">
                <MudSelectItem T="int?" Value="null">@AllDepartments</MudSelectItem>
                @foreach (var d in departments.Where(x => x.IsActive))
                {
                    <MudSelectItem T="int?" Value="d.Id">@OvertimeSheetRegistry.DepartmentLabel(d.Name)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="4">
            <TimeBox Text="@workIn" TextChanged="WorkInChangedAsync" Label="เวลาเข้า" Choices="choices.StartTimes" AllText="@AllTimes" />
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.subtitle2" Class="mt-6 mb-1">เพิ่มพนักงานทำ OT</MudText>
    <MudGrid Spacing="2" Class="align-end">
        <MudItem xs="12" sm="4" md="2">
            <TimeBox @bind-Text="workOut" Label="เวลาออก" Choices="choices.EndTimes" />
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudSelect T="int" @bind-Value="restMinutes" Label="เวลาพัก (นาที)">
                @foreach (var m in ShiftDto.RestMinuteChoices)
                {
                    <MudSelectItem T="int" Value="m">@m</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudSelect T="string" @bind-Value="type" Label="ประเภท">
                @foreach (var t in WorkTypes.Codes)
                {
                    <MudSelectItem T="string" Value="t">@WorkTypes.Label(t)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="5" />
        <MudItem xs="12" sm="6" md="5">
            <MudAutocomplete T="OvertimeSheetEmployee" Value="picked" ValueChanged="Pick" Label="รหัส (รหัส หรือ ชื่อ)"
                             SearchFunc="SearchAsync" ToStringFunc="@(e => e is null ? "" : $"{e.Code}  {e.Name}{(e.IsAbsent ? "  (ไม่มาทำงาน)" : "")}")"
                             Clearable="true" ResetValueOnEmptyText="true" MaxItems="50" />
        </MudItem>
        <MudItem xs="12" sm="6" md="5">
            <MudTextField @bind-Value="memo" Label="หมายเหตุ / งานที่ทำ" MaxLength="OvertimeSheetRegistry.MemoLength" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => { AddLine(); })"
                       Disabled="picked is null">เพิ่มในใบ</MudButton>
        </MudItem>
    </MudGrid>

    @* แก้ครั้งที่ 12: the day's OT already saved (read-only, "บันทึกแล้ว") as filtered above, then the new lines — the sheet prints them all. *@
    <MudSimpleTable Dense="true" Class="mt-4" FixedHeader="true" Style="height:22rem">
        <thead>
            <tr><th>ที่</th><th>รหัส</th><th>ชื่อ-นามสกุล</th><th>แผนก</th><th>เริ่มงาน</th><th>เลิกงาน</th><th>ประเภท</th><th>หมายเหตุ</th><th></th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < printed.Count; i++)
            {
                var p = printed[i];
                <tr class="ot-printed">
                    <td>@(i + 1)</td>
                    <td>@p.EmployeeCode</td>
                    <td>@p.EmployeeName</td>
                    <td>@p.DepartmentName</td>
                    <td>@TimeText.Format(p.WorkIn)</td>
                    <td>@TimeText.Format(p.WorkOut)</td>
                    <td>@p.Type</td>
                    <td>@p.Memo</td>
                    <td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">บันทึกแล้ว</MudChip></td>
                </tr>
            }
            @foreach (var line in lines)
            {
                <tr>
                    <td>@(printed.Count + lines.IndexOf(line) + 1)</td>
                    <td>@line.Employee.Code</td>
                    <td>
                        @line.Employee.Name
                        @if (line.Employee.IsAbsent)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">ไม่มาทำงาน</MudChip>
                        }
                    </td>
                    <td>@line.Employee.DepartmentName</td>
                    <td>@TimeText.Format(line.WorkIn)</td>
                    <td>@TimeText.Format(line.WorkOut)</td>
                    <td>@line.Type</td>
                    <td><MudTextField @bind-Value="line.Memo" Margin="Margin.Dense" MaxLength="OvertimeSheetRegistry.MemoLength" /></td>
                    <td>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">ใหม่</MudChip>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => lines.Remove(line))" />
                        </MudStack>
                    </td>
                </tr>
            }
            @if (printed.Count == 0 && lines.Count == 0)
            {
                <tr><td colspan="9">ไม่มีคนทำ OT ตามวัน แผนก และเวลาเข้าที่เลือก</td></tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudStack Row="true" Spacing="2" Class="mt-4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync" Disabled="busy">พิมพ์ใบตามที่แสดง</MudButton>
        @if (lastPrinted is { } key)
        {
            <MudButton Href="@OvertimeSheetPrints.Href(key)" Target="_blank" StartIcon="@Icons.Material.Filled.PictureAsPdf">เปิดใบที่พิมพ์ล่าสุด</MudButton>
        }
    </MudStack>
    <MudText Typo="Typo.caption" Class="d-block mt-2">เพิ่มพนักงาน: เลือกเวลาเข้าก่อน เวลาเข้า/ออก เวลาพัก และประเภทจะติดไปกับคนที่เพิ่ม — เปลี่ยนเวลาแล้วเพิ่มอีกกลุ่มได้ในใบเดียวกัน</MudText>
    <MudText Typo="Typo.caption" Class="d-block">ตารางแสดงทุกคนที่มีเวลา OT ในวันนั้น (รวมที่บันทึกจากหน้าอื่นและที่ย้ายมาจากโปรแกรมเดิม) ตามแผนกและเวลาเข้าที่เลือก — เลือก "ทุกแผนก" / "เวลาทั้งหมด" เพื่อดูทั้งวัน ใบที่พิมพ์ออกมาตามที่แสดง</MudText>
    <MudText Typo="Typo.caption" Class="d-block">กดพิมพ์แล้วเวลา OT ของแถว "ใหม่" จะถูกบันทึกเข้าเวลาทำงานทันที — แถว "บันทึกแล้ว" แก้หรือลบได้ที่หน้าแก้ไขเวลาทำงาน</MudText>
</MudPaper>

<MudButton Href="@EmployeeMenu.HrefOf(7)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    /// <summary>The defaults of the legacy form OT: W_OUT 20:20, REST_T 0, TYPE O1 (W_IN 17:20 is now เวลาทั้งหมด until one is chosen).</summary>
    private static readonly TimeOnly DefaultOut = new(20, 20);

    /// <summary>แก้ครั้งที่ 12: the choices of แผนก and เวลาเข้า that list the whole day.</summary>
    private const string AllDepartments = "ทุกแผนก", AllTimes = "เวลาทั้งหมด";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private DateTime? day = DateTime.Today;
    private IReadOnlyList<DepartmentDto> departments = [];
    private OvertimeSheetChoices choices = new([], [], []);
    private int? departmentId;
    private string? workIn, workOut;
    private int restMinutes;
    private string? type;
    private OvertimeSheetEmployee? picked;
    private string? memo;
    private List<LineForm> lines = [];
    private IReadOnlyList<OvertimeSheetLine> printed = [];
    private Guid? lastPrinted;
    private bool busy;

    private DateOnly Day => DateOnly.FromDateTime(day ?? DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        departments = await Services.RunAsync<OrgDirectory, IReadOnlyList<DepartmentDto>>(o => o.GetDepartmentsAsync());
        await LoadChoicesAsync();
        await ResetFormAsync();
    }

    private async Task DayChangedAsync(DateTime? value)
    {
        day = value;
        await LoadChoicesAsync();
        await LoadPrintedAsync();
    }

    private async Task DepartmentChangedAsync(int? value)
    {
        departmentId = value;
        await LoadPrintedAsync();
    }

    /// <summary>A time typed or picked lists only the rows starting then; เวลาทั้งหมด (or a time not finished yet) lists them all.</summary>
    private async Task WorkInChangedAsync(string? value)
    {
        workIn = value;
        await LoadPrintedAsync();
    }

    private string DepartmentText(int? id) => id is { } d && departments.FirstOrDefault(x => x.Id == d) is { } found
        ? OvertimeSheetRegistry.DepartmentLabel(found.Name) : AllDepartments;

    /// <summary>The เวลาเข้า the table and the sheet list: null = เวลาทั้งหมด.</summary>
    private TimeOnly? ListWorkIn => workIn != AllTimes && TimeText.TryParse(workIn, out var t) ? t : null;

    /// <summary>แก้ครั้งที่ 12: who works OT that day, in the แผนก and from the เวลาเข้า chosen (or all of them), from the database.</summary>
    private async Task LoadPrintedAsync()
    {
        var (date, department, start) = (Day, departmentId, ListWorkIn);
        printed = await Services.RunAsync<OvertimeSheetRegistry, IReadOnlyList<OvertimeSheetLine>>(r => r.GetDayLinesAsync(date, department, start));
    }

    /// <summary>ไม่มาทำงาน depends on the date: the lines already keyed take the new marks.</summary>
    private async Task LoadChoicesAsync()
    {
        var date = Day;
        choices = await Services.RunAsync<OvertimeSheetRegistry, OvertimeSheetChoices>(r => r.GetChoicesAsync(date));
        var byId = choices.Employees.ToDictionary(e => e.Id);
        foreach (var line in lines)
            if (byId.TryGetValue(line.Employee.Id, out var e)) line.Employee = e;
    }

    /// <summary>The form's defaults (the legacy form OT's, with เวลาเข้า = เวลาทั้งหมด so the whole day shows first).</summary>
    private async Task ResetFormAsync()
    {
        workIn = AllTimes;
        workOut = TimeText.Format(DefaultOut);
        restMinutes = 0;
        type = WorkTypes.Overtime;
        picked = null;
        memo = null;
        lines = [];
        await LoadPrintedAsync();
    }

    private Task<IEnumerable<OvertimeSheetEmployee>> SearchAsync(string? text, CancellationToken _)
    {
        var term = text?.Trim();
        return Task.FromResult(string.IsNullOrEmpty(term)
            ? choices.Employees
            : choices.Employees.Where(e => e.Code.StartsWith(term, StringComparison.OrdinalIgnoreCase) || e.Name.Contains(term)));
    }

    /// <summary>ID_AfterUpdate of OT1: ชื่อ and MEMO = หน้าที่ (WORK) of the employee.</summary>
    private void Pick(OvertimeSheetEmployee? employee)
    {
        picked = employee;
        memo = employee?.Duty;
        if (employee is { IsAbsent: true })
            Snackbar.Add($"{employee.Code} {employee.Name} บันทึกไม่มาทำงานวันนี้", Severity.Warning);
    }

    /// <summary>#411: the line keeps the times, rest and type of the form as they are when it is added, so one sheet can hold several shifts.</summary>
    private bool AddLine()
    {
        if (picked is null) return false;
        if (ListWorkIn is null)
        {
            Snackbar.Add("เลือกเวลาเข้าก่อนเพิ่มพนักงาน", Severity.Error);
            return false;
        }
        if (!TimeText.TryParse(workIn, out var start) || !TimeText.TryParse(workOut, out var end) || start is null || end is null)
        {
            Snackbar.Add("เวลาต้องเป็น ชั่วโมง:นาที เช่น 17:20", Severity.Error);
            return false;
        }
        lines.Add(new LineForm { Employee = picked, Memo = memo, WorkIn = start.Value, WorkOut = end.Value, RestMinutes = restMinutes, Type = type ?? WorkTypes.Overtime });
        picked = null;
        memo = null;
        return true;
    }

    private async Task PrintAsync()
    {
        // A picked employee not yet added is on the sheet too: the legacy subform saved the row being keyed.
        if (picked is not null && !AddLine()) return;
        // Every new line has its own times; the sheet lists the เวลาเข้า chosen, or the whole day.
        var input = new OvertimeSheetInput(Day, departmentId, null, null, restMinutes, type,
            lines.Select(l => new OvertimeSheetLineInput(l.Employee.Id, l.Memo, l.WorkIn, l.WorkOut, l.RestMinutes, l.Type)).ToList(), ListWorkIn);
        busy = true;
        try
        {
            var outcome = await Services.RunAsync<OvertimeSheetRegistry, OvertimeSheetOutcome>(r => r.PrintAsync(input));
            foreach (var e in outcome.Result.Errors) Snackbar.Add(e, Severity.Error);
            if (outcome.Sheet is not { } sheet) return;
            var user = (await AuthState).User.Identity?.Name ?? "";
            lastPrinted = Prints.Keep(sheet, user);
            if (outcome.Result.Id > 0) Snackbar.Add($"บันทึกเวลา OT {outcome.Result.Id} รายการแล้ว", Severity.Success);
            lines = [];
            printed = sheet.Lines;
            await JS.InvokeVoidAsync("open", OvertimeSheetPrints.Href(lastPrinted.Value), "_blank");
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class LineForm
    {
        public OvertimeSheetEmployee Employee { get; set; } = default!;
        public string? Memo { get; set; }
        public TimeOnly WorkIn { get; init; }
        public TimeOnly WorkOut { get; init; }
        public int RestMinutes { get; init; }
        public string Type { get; init; } = WorkTypes.Overtime;
    }
}
