@page "/hr/severance"
@attribute [Authorize]
@using Lockte.Hr
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage Storage

@* RPT-54 พิมพ์หนังสือเกษียณหรือปลดออก (ฟอร์ม เกษียณ, BR-070): employee, เหตุผล (MARK — printed on ฟอร์มปลดออก) and
   the ตารางวันชดเชย (columns 1–6 วัน, 7–13 ข้อความ). The table is a parameter, not a table (#41): the values typed
   last are remembered in this browser as next time's defaults; "ค่าเดิม" brings back the legacy values. *@
<PageTitle>พิมพ์หนังสือเกษียณหรือปลดออก — LOCKTE</PageTitle>
<h1 class="mb-4">พิมพ์หนังสือเกษียณหรือปลดออก</h1>

<MudPaper Class="pa-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <EmployeePicker @bind-Value="employee" />
        <MudTextField @bind-Value="reason" Label="เหตุผล (ปลดออก)" Style="min-width:24rem" />
    </MudStack>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">การจ่ายเงินชดเชยตามกฎหมายแรงงาน</MudText>
    <MudTextField @bind-Value="lines[0]" Label="ข้อความ (น้อยกว่า 120 วัน)" Class="mb-2" Style="max-width:32rem" />
    @for (var i = 0; i < 6; i++)
    {
        var step = i;
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="lines[step + 1]" Label="@($"ข้อความ (ตั้งแต่ {SeveranceScale.StepStarts[step]:N0} วัน)")" Style="min-width:24rem" />
            <MudNumericField T="int" @bind-Value="days[step]" Label="จ่าย (วัน)" Min="0" Style="max-width:8rem" />
        </MudStack>
    }

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="employee is null" Target="_blank"
                   Href="@Link("retire")" OnClick="RememberAsync" StartIcon="@Icons.Material.Filled.Print">เกษียณ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="employee is null" Target="_blank"
                   Href="@Link("dismiss")" OnClick="RememberAsync" StartIcon="@Icons.Material.Filled.Print">ปลดออก</MudButton>
        <MudButton OnClick="Reset">ค่าเดิม</MudButton>
    </MudStack>
</MudPaper>

<MudButton Href="@EmployeeMenu.HrefOf(19)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private const string StorageKey = "hr.severance-scale";

    private EmployeeListItem? employee;
    private string? reason;
    private int[] days = [.. SeveranceScale.Legacy.Days];
    private string[] lines = [.. SeveranceScale.Legacy.Lines];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (await Storage.GetAsync<Remembered>(StorageKey) is { Success: true, Value: { Days.Length: 6, Lines.Length: 7 } saved })
            {
                days = saved.Days;
                lines = saved.Lines;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Nothing remembered (or unreadable): keep the legacy values.
        }
    }

    private async Task RememberAsync()
    {
        try { await Storage.SetAsync(StorageKey, new Remembered(days, lines)); }
        catch (Exception) { /* remembering is a convenience only */ }
    }

    private void Reset()
    {
        days = [.. SeveranceScale.Legacy.Days];
        lines = [.. SeveranceScale.Legacy.Lines];
    }

    private string? Link(string kind)
    {
        if (employee is null) return null;
        var query = string.Concat(days.Select(d => $"&day={d}")) + string.Concat(lines.Select(l => $"&line={Uri.EscapeDataString(l ?? "")}"));
        return $"reports/hr/severance/{employee.Id}?kind={kind}&reason={Uri.EscapeDataString(reason ?? "")}{query}";
    }

    private sealed record Remembered(int[] Days, string[] Lines);
}
