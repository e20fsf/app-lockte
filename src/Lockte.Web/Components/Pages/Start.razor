@page "/"
@attribute [Authorize]
@using System.Security.Claims
@inject ScopedServices Services
@inject NavigationManager Navigation

@* Where a staff user lands after login: always the program chooser (UAT-1, #275). *@
<PageTitle>LOCKTE</PageTitle>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // UAT-1 (#275): after login everyone starts at หน้าเลือกโปรแกรม, not at the program worked in last.
        Navigation.NavigateTo(ProgramMenus.ChooserHref, replace: true);
    }
}
