@page "/hr/{Code}"
@attribute [Authorize]

@* Every menu leaf lands here until its ticket builds the real screen (#41 ลำดับการสร้าง). *@
<PageTitle>@Title — LOCKTE</PageTitle>
<div class="menu-page">
    <h1 class="menu-title">@Title</h1>
    <MudAlert Severity="Severity.Info" Class="my-4">หน้านี้ยังไม่เปิดใช้งาน (@Code)</MudAlert>
    @if (found is { } f)
    {
        <MudButton Href="@EmployeeMenu.HrefOf(f.Page.Number)" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
            กลับเมนูเดิม
        </MudButton>
    }
    else
    {
        <MudButton Href="" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">กลับเมนูหลัก</MudButton>
    }
</div>

@code {
    [Parameter]
    public string Code { get; set; } = "";

    private (MenuPage Page, MenuItem Item)? found;

    private string Title => found?.Item.Text ?? Code;

    protected override void OnParametersSet() => found = EmployeeMenu.FindItem(Code);
}
