@page "/admin/users"
@attribute [Authorize(Policy = AuthPolicies.Admin)]
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

<PageTitle>จัดการ user — LOCKTE</PageTitle>
<h1 class="mb-4">จัดการ user</h1>

<MudPaper Class="pa-4 mb-6" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">เพิ่ม user</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="newUserName" Label="ชื่อ user" HelperText="อังกฤษ/ตัวเลข เช่น somchai" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="newDisplayName" Label="ชื่อที่แสดง" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="newPassword" Label="รหัสชั่วคราว" HelperText="อย่างน้อย 8 ตัว" /></MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="busy">เพิ่ม</MudButton>
        </MudItem>
        <MudItem xs="12" Class="d-flex flex-wrap align-center mt-n2">
            <MudText Typo="Typo.body2" Class="mr-2">เข้าโปรแกรมได้:</MudText>
            @foreach (var (key, name) in ProgramNames)
            {
                <MudCheckBox T="bool" Value="newPrograms.Contains(key)" ValueChanged="@(v => Toggle(newPrograms, key, v))" Label="@name" Dense="true" />
            }
            <MudCheckBox T="bool" @bind-Value="newCanViewPay" Label="ดูข้อมูลค่าจ้างได้" Dense="true" Class="ml-4" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="users" Dense="true" Hover="true" Loading="users is null">
    <HeaderContent>
        <MudTh>ชื่อ user</MudTh>
        <MudTh>ชื่อที่แสดง</MudTh>
        <MudTh>สถานะ</MudTh>
        @foreach (var (_, name) in ProgramNames)
        {
            <MudTh Style="text-align:center">@name</MudTh>
        }
        <MudTh>ดูข้อมูลค่าจ้างได้</MudTh>
        <MudTh>แก้ล่าสุด</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.UserName</MudTd>
        <MudTd>
            @if (nameFor?.Id == context.Id)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                    <MudTextField @bind-Value="newName" Margin="Margin.Dense" MaxLength="UserAdminService.DisplayNameLength" Immediate="true" AutoFocus="true"
                                  OnKeyUp="@(e => e.Key == "Enter" ? SaveNameAsync() : e.Key == "Escape" ? CancelName() : Task.CompletedTask)"
                                  aria-label="@($"ชื่อที่แสดงใหม่ {context.UserName}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" OnClick="SaveNameAsync" Disabled="busy" aria-label="บันทึกชื่อ" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelName" aria-label="ยกเลิก" />
                </MudStack>
            }
            else
            {
                @context.DisplayName
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => StartName(context)" Disabled="busy"
                               aria-label="@($"แก้ชื่อที่แสดง {context.UserName}")" Title="แก้ชื่อที่แสดง" />
            }
        </MudTd>
        <MudTd>
            @if (!context.IsActive) { <MudChip T="string" Size="Size.Small" Color="Color.Default">ปิดใช้งาน</MudChip> }
            else if (context.LockedUntil is { } until) { <MudChip T="string" Size="Size.Small" Color="Color.Error">ล็อกถึง @until.ToLocalTime().ToString("HH:mm") น.</MudChip> }
            else { <MudChip T="string" Size="Size.Small" Color="Color.Success">ใช้งาน</MudChip> }
            @if (context.MustChangePassword) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">รอเปลี่ยนรหัส</MudChip> }
        </MudTd>
        @foreach (var (key, name) in ProgramNames)
        {
            <MudTd Style="text-align:center">
                @if (!context.IsAdmin)
                {
                    <MudCheckBox T="bool" Value="context.Programs.Contains(key)" ValueChanged="@(v => SetProgramAsync(context, key, v))" Dense="true"
                                 Disabled="busy" aria-label="@($"เข้าโปรแกรม{name} {context.UserName}")" />
                }
            </MudTd>
        }
        <MudTd>
            @if (context.IsAdmin)
            {
                <MudText Typo="Typo.caption">ไม่มีสิทธิ์</MudText>
            }
            else
            {
                <MudCheckBox T="bool" Value="context.CanViewPay" ValueChanged="@(v => SetCanViewPayAsync(context, v))" Dense="true"
                             Disabled="busy" aria-label="@($"ดูข้อมูลค่าจ้างได้ {context.UserName}")" />
            }
        </MudTd>
        <MudTd>@context.UpdatedBy @context.UpdatedAt.ToLocalTime().ToString("d/M/yyyy HH:mm", ThaiCulture)</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" OnClick="() => StartTempPassword(context)" Disabled="busy">ตั้งรหัสชั่วคราว</MudButton>
            @if (!context.IsAdmin)
            {
                <MudButton Size="Size.Small" Color="@(context.IsActive ? Color.Error : Color.Success)"
                           OnClick="() => SetActiveAsync(context, !context.IsActive)" Disabled="busy">
                    @(context.IsActive ? "ปิดใช้งาน" : "เปิดใช้งาน")
                </MudButton>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@if (tempFor is { } target)
{
    <MudPaper Class="pa-4 mt-4" Outlined="true">
        <MudText Typo="Typo.h6">ตั้งรหัสชั่วคราวให้ @target.DisplayName (@target.UserName)</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">ผู้ใช้จะถูกบังคับเปลี่ยนรหัสตอน login ครั้งถัดไป และถ้าถูกล็อกอยู่จะปลดล็อกด้วย</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="tempPassword" Label="รหัสชั่วคราว" HelperText="อย่างน้อย 8 ตัว" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SetTempPasswordAsync" Disabled="busy">บันทึก</MudButton>
            <MudButton OnClick="() => tempFor = null">ยกเลิก</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private IReadOnlyList<UserSummary>? users;
    private string newUserName = "", newDisplayName = "", newPassword = "";
    private bool newCanViewPay;
    private readonly HashSet<string> newPrograms = [];

    /// <summary>ADR 0005: the programs' short names, as on the sheet "จำนวนคนใช้ program", in chooser order.</summary>
    private static readonly (string Key, string Name)[] ProgramNames =
    [
        (EmployeeMenu.Menu.Key, "พนักงาน"), (OrderMenu.Menu.Key, "ผลผลิต"), (PurchMenu.Menu.Key, "วัตถุดิบ"),
        (CalibMenu.Menu.Key, "สอบเทียบ"), (CashMenu.Menu.Key, "เงินสดย่อย"),
    ];

    private static void Toggle(HashSet<string> programs, string key, bool on)
    {
        if (on) programs.Add(key); else programs.Remove(key);
    }
    private UserSummary? tempFor;
    private UserSummary? nameFor;
    private string newName = "";
    private string tempPassword = "";
    private bool busy;
    private static readonly System.Globalization.CultureInfo ThaiCulture = new("th-TH");

    protected override Task OnInitializedAsync() => ReloadAsync();

    private Task<T> UseAsync<T>(Func<UserAdminService, Task<T>> action) => Services.RunAsync(action);

    private async Task ReloadAsync() => users = await UseAsync(s => s.ListAsync());

    private Task CreateAsync() => RunAsync(
        s => s.CreateAsync(newUserName, newDisplayName, newPassword, newCanViewPay, newPrograms),
        $"เพิ่ม user {newUserName.Trim()} แล้ว",
        () => { newUserName = newDisplayName = newPassword = ""; newCanViewPay = false; newPrograms.Clear(); });

    private Task SetProgramAsync(UserSummary user, string key, bool allowed)
    {
        var programs = user.Programs.ToHashSet();
        Toggle(programs, key, allowed);
        var name = ProgramNames.First(p => p.Key == key).Name;
        return RunAsync(
            s => s.SetProgramsAsync(user.Id, programs, user.RowVersion),
            allowed ? $"{user.UserName} เข้าโปรแกรม{name}ได้แล้ว (มีผลเมื่อเข้าระบบใหม่)" : $"{user.UserName} เข้าโปรแกรม{name}ไม่ได้แล้ว");
    }

    private Task SetCanViewPayAsync(UserSummary user, bool allowed) => RunAsync(
        s => s.SetCanViewPayAsync(user.Id, allowed, user.RowVersion),
        allowed ? $"{user.UserName} ดูข้อมูลค่าจ้างได้แล้ว (มีผลเมื่อเข้าระบบใหม่)" : $"{user.UserName} ดูข้อมูลค่าจ้างไม่ได้แล้ว");

    private Task SetActiveAsync(UserSummary user, bool active) => RunAsync(
        s => s.SetActiveAsync(user.Id, active, user.RowVersion),
        active ? $"เปิดใช้งาน {user.UserName} แล้ว" : $"ปิดใช้งาน {user.UserName} แล้ว");

    private void StartName(UserSummary user)
    {
        nameFor = user;
        newName = user.DisplayName;
    }

    private Task CancelName()
    {
        nameFor = null;
        return Task.CompletedTask;
    }

    private Task SaveNameAsync() => RunAsync(
        s => s.SetDisplayNameAsync(nameFor!.Id, newName, nameFor.RowVersion),
        $"แก้ชื่อที่แสดงของ {nameFor!.UserName} เป็น {newName.Trim()} แล้ว (แถบหัวเปลี่ยนเมื่อเข้าระบบใหม่)",
        () => nameFor = null);

    private void StartTempPassword(UserSummary user)
    {
        tempFor = user;
        tempPassword = "";
    }

    private Task SetTempPasswordAsync() => RunAsync(
        s => s.SetTemporaryPasswordAsync(tempFor!.Id, tempPassword, tempFor.RowVersion),
        $"ตั้งรหัสชั่วคราวให้ {tempFor!.UserName} แล้ว",
        () => tempFor = null);

    private async Task RunAsync(Func<UserAdminService, Task<AccountResult>> action, string done, Action? onSuccess = null)
    {
        busy = true;
        try
        {
            var result = await UseAsync(action);
            if (result.Succeeded)
            {
                Snackbar.Add(done, Severity.Success);
                onSuccess?.Invoke();
            }
            else
            {
                foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            }
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            tempFor = null;
            nameFor = null;
        }
        finally
        {
            await ReloadAsync();
            busy = false;
        }
    }
}
