@using Lockte.Org
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* ทะเบียนกะ A–G พร้อมเวลา (T-SHIFT). An out time earlier than the in time is the next day. *@
<MudTable Items="Shifts" Dense="true" Hover="true" T="ShiftDto" OnRowClick="@((TableRowClickEventArgs<ShiftDto> e) => Edit(e.Item!))">
    <HeaderContent>
        <MudTh>กะ</MudTh>
        <MudTh>เข้า–ออก</MudTh>
        <MudTh>พัก</MudTh>
        <MudTh>OT</MudTh>
        <MudTh>นาทีพัก</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Code</MudTd>
        <MudTd>@Range(context.WorkIn, context.WorkOut)</MudTd>
        <MudTd>@Range(context.BreakStart, context.BreakEnd)</MudTd>
        <MudTd>@Range(context.OvertimeIn, context.OvertimeOut)</MudTd>
        <MudTd>@context.RestMinutes</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>ยังไม่มีกะ</MudText></NoRecordsContent>
</MudTable>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">@(form.Id is null ? "เพิ่มกะ" : $"แก้กะ {form.Code}")</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="4" sm="1"><MudTextField @bind-Value="form.Code" Label="รหัสกะ" MaxLength="1" /></MudItem>
        <MudItem xs="4" sm="2"><MudTimePicker @bind-Time="form.WorkIn" Label="เวลาเข้า" AmPm="false" /></MudItem>
        <MudItem xs="4" sm="2"><MudTimePicker @bind-Time="form.WorkOut" Label="เวลาออก" AmPm="false" /></MudItem>
        <MudItem xs="6" sm="2"><MudTimePicker @bind-Time="form.BreakStart" Label="เริ่มพัก" AmPm="false" Clearable="true" /></MudItem>
        <MudItem xs="6" sm="2"><MudTimePicker @bind-Time="form.BreakEnd" Label="เลิกพัก" AmPm="false" Clearable="true" /></MudItem>
        <MudItem xs="6" sm="1"><MudTimePicker @bind-Time="form.OvertimeIn" Label="เริ่ม OT" AmPm="false" Clearable="true" /></MudItem>
        <MudItem xs="6" sm="1"><MudTimePicker @bind-Time="form.OvertimeOut" Label="เลิก OT" AmPm="false" Clearable="true" /></MudItem>
        <MudItem xs="6" sm="1">
            <MudSelect T="int" @bind-Value="form.RestMinutes" Label="นาทีพัก">
                @foreach (var m in new[] { 0, 10, 20, 30, 40, 50, 60 })
                {
                    <MudSelectItem T="int" Value="m">@m</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
    <MudStack Row="true" Class="mt-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy">บันทึก</MudButton>
        <MudButton OnClick="@(() => form = new())">กะใหม่</MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ShiftDto> Shifts { get; set; } = [];

    [Parameter]
    public EventCallback Changed { get; set; }

    private ShiftForm form = new();
    private bool busy;

    private static string Range(TimeOnly? from, TimeOnly? to)
        => from is { } f && to is { } t ? $"{f:HH\\:mm}–{t:HH\\:mm}{(t < f ? " (+1)" : "")}" : "–";

    private void Edit(ShiftDto s) => form = new ShiftForm
    {
        Id = s.Id, Code = s.Code, WorkIn = s.WorkIn.ToTimeSpan(), WorkOut = s.WorkOut.ToTimeSpan(),
        BreakStart = s.BreakStart?.ToTimeSpan(), BreakEnd = s.BreakEnd?.ToTimeSpan(),
        OvertimeIn = s.OvertimeIn?.ToTimeSpan(), OvertimeOut = s.OvertimeOut?.ToTimeSpan(),
        RestMinutes = s.RestMinutes, RowVersion = s.RowVersion,
    };

    private async Task SaveAsync()
    {
        if (form.WorkIn is not { } workIn || form.WorkOut is not { } workOut)
        {
            Snackbar.Add("กรุณากรอกเวลาเข้าและเวลาออก", Severity.Error);
            return;
        }
        busy = true;
        try
        {
            static TimeOnly? Time(TimeSpan? t) => t is { } v ? TimeOnly.FromTimeSpan(v) : null;
            var input = new ShiftInput(form.Id, form.Code, TimeOnly.FromTimeSpan(workIn), TimeOnly.FromTimeSpan(workOut),
                Time(form.BreakStart), Time(form.BreakEnd), Time(form.OvertimeIn), Time(form.OvertimeOut),
                form.RestMinutes, form.RowVersion);
            var result = await Services.RunAsync<OrgRegistry, ServiceResult>(r => r.SaveShiftAsync(input));
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (result.Succeeded)
            {
                Snackbar.Add("บันทึกแล้ว", Severity.Success);
                form = new();
                await Changed.InvokeAsync();
            }
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            form = new();
            await Changed.InvokeAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class ShiftForm
    {
        public int? Id { get; set; }
        public string Code { get; set; } = "";
        public TimeSpan? WorkIn { get; set; }
        public TimeSpan? WorkOut { get; set; }
        public TimeSpan? BreakStart { get; set; }
        public TimeSpan? BreakEnd { get; set; }
        public TimeSpan? OvertimeIn { get; set; }
        public TimeSpan? OvertimeOut { get; set; }
        public int RestMinutes { get; set; } = 60;
        public byte[]? RowVersion { get; set; }
    }
}
