@page "/org/departments"
@attribute [Authorize]
@using Lockte.Org
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* SCR-05 เพิ่มและแก้ไขรายชื่อแผนก (ฟอร์ม แผนก2). Same fields in the same order — ลำดับ, แผนก, ตัวอักษรนำหน้า, ฝ่าย,
   หัวหน้า, ผู้จัดการ, กะ, ผู้จัดการโรงงาน — on the company-wide register (#16): one row per department with its
   shifts ticked, instead of one row per department × shift; รหัสแผนก is new (business key). As before there is no
   delete button: clear the name and save (BR-051). ฝ่าย and กะ come from the data migration; shift times are
   edited from SCR-11. *@
<PageTitle>เพิ่มและแก้ไขรายชื่อแผนก — LOCKTE</PageTitle>
<h1 class="mb-4">เพิ่มและแก้ไขรายชื่อแผนก</h1>

<MudTable Items="departments" Dense="true" Hover="true" Loading="departments is null" T="DepartmentDto"
          OnRowClick="@((TableRowClickEventArgs<DepartmentDto> e) => Edit(e.Item!))">
    <HeaderContent>
        <MudTh>ลำดับ</MudTh>
        <MudTh>แผนก</MudTh>
        <MudTh>ตัวอักษรนำหน้า</MudTh>
        <MudTh>ฝ่าย</MudTh>
        <MudTh>หัวหน้า</MudTh>
        <MudTh>ผู้จัดการ</MudTh>
        <MudTh>กะ</MudTh>
        <MudTh>ผู้จัดการโรงงาน</MudTh>
        <MudTh>รหัสแผนก</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.SortOrder</MudTd>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.EmployeeIdPrefix</MudTd>
        <MudTd>@context.SectionName</MudTd>
        <MudTd></MudTd>
        <MudTd>@context.ManagerName</MudTd>
        <MudTd>@string.Join(", ", context.Shifts.Select(s => s.ShiftCode))</MudTd>
        <MudTd>@context.FactoryManagerName</MudTd>
        <MudTd>@context.Code</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>ยังไม่มีแผนก</MudText></NoRecordsContent>
</MudTable>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">@(form.Id is null ? "เพิ่มแผนก" : $"แก้แผนก {form.Code}")</MudText>
        <MudSpacer />
        <MudButton OnClick="New" StartIcon="@Icons.Material.Filled.Add">รายการใหม่</MudButton>
    </MudStack>
    @if (sections.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-2">ยังไม่มีทะเบียนฝ่าย — ย้ายข้อมูลจาก Access ก่อน</MudAlert>
    }
    <MudGrid Spacing="2">
        <MudItem xs="4" sm="1"><MudNumericField @bind-Value="form.SortOrder" Label="ลำดับ" HideSpinButtons="true" /></MudItem>
        <MudItem xs="8" sm="3"><MudTextField @bind-Value="form.Name" Label="แผนก" HelperText="ล้างชื่อแล้วบันทึก = ลบแผนก" /></MudItem>
        <MudItem xs="6" sm="2"><MudTextField @bind-Value="form.Prefix" Label="ตัวอักษรนำหน้ารหัสพนักงาน" MaxLength="1" /></MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="int?" @bind-Value="form.SectionId" Label="ฝ่าย">
                @foreach (var s in sections)
                {
                    <MudSelectItem T="int?" Value="s.Id">@s.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField T="string" Value="@("")" Label="หัวหน้า" Disabled="true" HelperText="เลือกจากทะเบียนพนักงานได้เมื่อทะเบียนพร้อม" />
        </MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="form.Manager" Label="ผู้จัดการ" /></MudItem>
        <MudItem xs="12" sm="8">
            <MudText Typo="Typo.subtitle2">กะ</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4">
                @foreach (var shift in shifts)
                {
                    <MudStack Spacing="0">
                        <MudCheckBox T="bool" Value="form.ShiftIds.Contains(shift.Id)" ValueChanged="@(on => ToggleShift(shift.Id, on))" Label="@($"กะ {shift.Code}")" />
                        <MudTextField T="string" Value="@("")" Label="หัวหน้ากะ" Disabled="true" Margin="Margin.Dense" Style="max-width:10rem" />
                    </MudStack>
                }
            </MudStack>
        </MudItem>
        <MudItem xs="12" sm="4"><MudTextField @bind-Value="form.FactoryManager" Label="ผู้จัดการโรงงาน" /></MudItem>
        <MudItem xs="6" sm="2"><MudTextField @bind-Value="form.Code" Label="รหัสแผนก" MaxLength="OrgRegistry.DepartmentCodeLength" /></MudItem>
    </MudGrid>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy" Class="mt-2">บันทึก</MudButton>
</MudPaper>

@code {
    private IReadOnlyList<DepartmentDto>? departments;
    private IReadOnlyList<SectionDto> sections = [];
    private IReadOnlyList<ShiftDto> shifts = [];
    private DepartmentForm form = new();
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        New();
    }

    private async Task ReloadAsync()
        => (departments, sections, shifts) = await Services.RunAsync<OrgDirectory, (IReadOnlyList<DepartmentDto>, IReadOnlyList<SectionDto>, IReadOnlyList<ShiftDto>)>(
            async d => (await d.GetDepartmentsAsync(), await d.GetSectionsAsync(), await d.GetShiftsAsync()));

    private void New() => form = new DepartmentForm { SortOrder = (departments?.Count ?? 0) + 1 };

    private void Edit(DepartmentDto d) => form = new DepartmentForm
    {
        Id = d.Id, SortOrder = d.SortOrder, Code = d.Code, Name = d.Name, Prefix = d.EmployeeIdPrefix, SectionId = d.SectionId,
        HeadEmployeeId = d.HeadEmployeeId, Manager = d.ManagerName, FactoryManager = d.FactoryManagerName, RowVersion = d.RowVersion,
        ShiftIds = d.Shifts.Select(s => s.ShiftId).ToHashSet(),
    };

    private void ToggleShift(int shiftId, bool on)
    {
        if (on) form.ShiftIds.Add(shiftId); else form.ShiftIds.Remove(shiftId);
    }

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var input = new DepartmentInput(form.Id, form.Code, form.Name, form.Prefix, form.SortOrder, form.SectionId,
                form.HeadEmployeeId, form.Manager, form.FactoryManager, form.ShiftIds, form.RowVersion);
            var result = await Services.RunAsync<OrgRegistry, ServiceResult>(r => r.SaveDepartmentAsync(input));
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (!result.Succeeded) return;

            Snackbar.Add("บันทึกแล้ว", Severity.Success);
            await ReloadAsync();
            if (departments!.FirstOrDefault(d => d.Id == result.Id) is { } saved) Edit(saved); else New();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            await ReloadAsync();
            New();
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class DepartmentForm
    {
        public int? Id { get; set; }
        public int SortOrder { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string Prefix { get; set; } = "";
        public int? SectionId { get; set; }
        public int? HeadEmployeeId { get; set; }
        public string? Manager { get; set; }
        public string? FactoryManager { get; set; }
        public byte[]? RowVersion { get; set; }
        public HashSet<int> ShiftIds { get; set; } = [];
    }
}
