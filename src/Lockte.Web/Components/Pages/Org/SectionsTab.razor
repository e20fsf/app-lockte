@using Lockte.Org
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* ทะเบียนฝ่าย (T-ฝ่าย). *@
<MudTable Items="Sections" Dense="true" Hover="true" T="SectionDto" OnRowClick="@((TableRowClickEventArgs<SectionDto> e) => Edit(e.Item!))">
    <HeaderContent>
        <MudTh>ลำดับ</MudTh>
        <MudTh>ฝ่าย</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.SortOrder</MudTd>
        <MudTd>@context.Name</MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>ยังไม่มีฝ่าย</MudText></NoRecordsContent>
</MudTable>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">@(id is null ? "เพิ่มฝ่าย" : "แก้ฝ่าย")</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudNumericField @bind-Value="sortOrder" Label="ลำดับ" HideSpinButtons="true" Style="max-width:6rem" />
        <MudTextField @bind-Value="name" Label="ชื่อฝ่าย" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy">บันทึก</MudButton>
        <MudButton OnClick="New">ฝ่ายใหม่</MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SectionDto> Sections { get; set; } = [];

    [Parameter]
    public EventCallback Changed { get; set; }

    private int? id;
    private int sortOrder;
    private string name = "";
    private byte[]? rowVersion;
    private bool busy;

    private void New() => (id, sortOrder, name, rowVersion) = (null, Sections.Count + 1, "", null);

    private void Edit(SectionDto s) => (id, sortOrder, name, rowVersion) = (s.Id, s.SortOrder, s.Name, s.RowVersion);

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var input = new SectionInput(id, name, sortOrder, rowVersion);
            var result = await Services.RunAsync<OrgRegistry, ServiceResult>(r => r.SaveSectionAsync(input));
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (result.Succeeded)
            {
                Snackbar.Add("บันทึกแล้ว", Severity.Success);
                New();
                await Changed.InvokeAsync();
            }
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            New();
            await Changed.InvokeAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
