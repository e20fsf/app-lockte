@page "/order/yield-reports"
@attribute [Authorize]
@using System.Globalization
@using Lockte.SharedKernel
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage Storage

@* The output reports (#138, the buttons of the form รายงานผลผลิต): พิมพ์ผลผลิตประจำเดือน (RPT-16, % ของเสียเทียบเป้า), รายงานผลผลิตรวมทุกแผนก (ตามรหัส / ตามรุ่น), รวมแผนกไดคาสท์, and ผลผลิตเดือน
   (มค.–ธค. at once). They read the reports that went into the stock: transfer the range first (SCR-16). The dates and the year are remembered in this browser (BR-022). *@
<PageTitle>รายงานผลผลิต — LOCKTE</PageTitle>
<h1 class="mb-4">รายงานผลผลิต</h1>

<MudPaper Class="pa-4" Outlined="true" Style="max-width:52rem">
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">รายงานเหล่านี้นับเฉพาะใบรายงานที่โอนเข้าสต็อกแล้ว — โอนผลผลิตของช่วงนั้นก่อน</MudAlert>
    <MudStack Row="true" Spacing="2">
        <MudDatePicker Editable="true" @bind-Date="from" @bind-Date:after="RememberAsync" Label="ตั้งแต่วันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:16rem" />
        <MudDatePicker Editable="true" @bind-Date="to" @bind-Date:after="RememberAsync" Label="ถึงวันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:16rem" />
    </MudStack>
    @if (Problem is { } problem)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@problem</MudAlert>
    }
    <MudStack Spacing="1" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@Url("monthly")" Target="_blank" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.Print">พิมพ์ผลผลิตประจำเดือน (% ของเสียเทียบเป้า)</MudButton>
        <MudButton Variant="Variant.Outlined" Href="@Url("all/code")" Target="_blank" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.Print">รายงานผลผลิตรวมทุกแผนก (ตามรหัสสินค้า)</MudButton>
        <MudButton Variant="Variant.Outlined" Href="@Url("all/model")" Target="_blank" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.Print">รายงานผลผลิตรวมทุกแผนก (ตามรุ่น)</MudButton>
        <MudButton Variant="Variant.Outlined" Href="@Url("die-cast")" Target="_blank" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.Print">รายงานผลผลิตรวมแผนกไดคาสท์ (ใช้อลูมิเนียม)</MudButton>
    </MudStack>
    <MudDivider Class="my-4" />
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudNumericField T="int" @bind-Value="year" @bind-Value:after="RememberAsync" Label="ปี (ค.ศ.)" Min="1990" Max="2200" HideSpinButtons="true" Style="max-width:10rem" />
        <MudButton Variant="Variant.Outlined" Href="@($"/reports/order/yield/year?year={year}")" Target="_blank" StartIcon="@Icons.Material.Filled.Print">พิมพ์ผลผลิตเดือน (มค.–ธค.)</MudButton>
    </MudStack>
</MudPaper>

<MudButton Href="@OrderMenu.HrefOf(3)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private DateTime? from = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? to = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(1).AddDays(-1);
    private int year = DateTime.Today.Year;
    private bool loadedMemory;

    private string? Problem => from is null || to is null ? "กรุณากรอกตั้งแต่วันที่และถึงวันที่" : from > to ? "ตั้งแต่วันที่ต้องไม่หลังถึงวันที่" : null;

    private string Url(string path)
        => $"/reports/order/yield/{path}?from={from?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}&to={to?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedMemory) return;
        loadedMemory = true;
        try
        {
            if (await Storage.GetAsync<Remembered>("order.yield-reports") is { Success: true, Value: { } saved })
            {
                from = saved.From?.ToDateTime(TimeOnly.MinValue) ?? from;
                to = saved.To?.ToDateTime(TimeOnly.MinValue) ?? to;
                if (saved.Year is { } y) year = y;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Nothing remembered (or unreadable): keep the month.
        }
    }

    private async Task RememberAsync()
    {
        try { await Storage.SetAsync("order.yield-reports", new Remembered(from is { } f ? DateOnly.FromDateTime(f) : null, to is { } t ? DateOnly.FromDateTime(t) : null, year)); }
        catch (Exception) { /* remembering is a convenience only */ }
    }

    private sealed record Remembered(DateOnly? From, DateOnly? To, int? Year);
}
