@page "/order/products/lists"
@attribute [Authorize]
@using Lockte.Prod
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* รายการเลือกของ SCR-03 — ประเภทสินค้า (T-ประเภท), ชนิดเบรก (T-TYPE), รุ่น (T-MODEL), กลุ่มสินค้า (T-รหัสสินค้าย่อ) — as
   master data the user edits (the legacy lists were tables and, for ประเภท and รุ่น, the values already in use).
   รหัสกลุ่ม is an Access LIKE pattern on the product code: * any text, ? one character, # one digit; patterns may
   overlap on purpose (Q-26). One that products use cannot be deleted. *@
<PageTitle>รายการเลือกของสินค้า — LOCKTE</PageTitle>
<h1 class="mb-4">รายการเลือกของสินค้า</h1>

<MudTabs Elevation="0" Rounded="true" PanelClass="pt-4">
    <MudTabPanel Text="ประเภทสินค้า">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="typeForm.Name" Label="ชื่อประเภท" MaxLength="ProductRegistry.TextLength" Style="min-width:20rem" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="@(() => RunAsync(r => r.SaveProductTypeAsync(typeForm.Id, typeForm.Name, typeForm.RowVersion), () => typeForm = new()))">บันทึก</MudButton>
            @if (typeForm.Id is not null)
            {
                <MudButton Color="Color.Error" Disabled="busy" OnClick="@(() => ConfirmDeleteAsync($"ประเภทสินค้า {typeForm.Name}", r => r.DeleteProductTypeAsync(typeForm.Id!.Value, typeForm.RowVersion!), () => typeForm = new()))">ลบ</MudButton>
                <MudButton OnClick="@(() => typeForm = new())">รายการใหม่</MudButton>
            }
        </MudStack>
        <MudTable Items="types" Dense="true" Hover="true" Class="mt-3" T="ProductTypeDto" Breakpoint="Breakpoint.None"
                  OnRowClick="@((TableRowClickEventArgs<ProductTypeDto> e) => typeForm = new() { Id = e.Item!.Id, Name = e.Item.Name, RowVersion = e.Item.RowVersion })">
            <HeaderContent><MudTh>ประเภท</MudTh></HeaderContent>
            <RowTemplate><MudTd>@context.Name</MudTd></RowTemplate>
            <NoRecordsContent><MudText>ยังไม่มีประเภทสินค้า</MudText></NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="ชนิดเบรก">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="brakeForm.Code" Label="รหัสชนิด (TYPE)" MaxLength="ProductRegistry.BrakeTypeCodeLength" Style="max-width:10rem" HelperText="เช่น 2 = ดรัม, 4 = ดิสก์" />
            <MudTextField @bind-Value="brakeForm.Name" Label="ชื่อชนิด" MaxLength="ProductRegistry.TextLength" Style="min-width:16rem" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="@(() => RunAsync(r => r.SaveBrakeTypeAsync(brakeForm.Id, brakeForm.Code, brakeForm.Name, brakeForm.RowVersion), () => brakeForm = new()))">บันทึก</MudButton>
            @if (brakeForm.Id is not null)
            {
                <MudButton Color="Color.Error" Disabled="busy" OnClick="@(() => ConfirmDeleteAsync($"ชนิดเบรก {brakeForm.Name}", r => r.DeleteBrakeTypeAsync(brakeForm.Id!.Value, brakeForm.RowVersion!), () => brakeForm = new()))">ลบ</MudButton>
                <MudButton OnClick="@(() => brakeForm = new())">รายการใหม่</MudButton>
            }
        </MudStack>
        <MudTable Items="brakeTypes" Dense="true" Hover="true" Class="mt-3" T="BrakeTypeDto" Breakpoint="Breakpoint.None"
                  OnRowClick="@((TableRowClickEventArgs<BrakeTypeDto> e) => brakeForm = new() { Id = e.Item!.Id, Code = e.Item.Code, Name = e.Item.Name, RowVersion = e.Item.RowVersion })">
            <HeaderContent><MudTh>รหัส</MudTh><MudTh>ชนิด</MudTh></HeaderContent>
            <RowTemplate><MudTd>@context.Code</MudTd><MudTd>@context.Name</MudTd></RowTemplate>
            <NoRecordsContent><MudText>ยังไม่มีชนิดเบรก</MudText></NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="รุ่น">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="modelForm.Name" Label="รุ่น" MaxLength="ProductRegistry.TextLength" Style="min-width:20rem" HelperText="ชื่อรุ่น + ตัวแปร เช่น C100 A" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="@(() => RunAsync(r => r.SaveModelAsync(modelForm.Id, modelForm.Name, modelForm.RowVersion), () => modelForm = new()))">บันทึก</MudButton>
            @if (modelForm.Id is not null)
            {
                <MudButton Color="Color.Error" Disabled="busy" OnClick="@(() => ConfirmDeleteAsync($"รุ่น {modelForm.Name}", r => r.DeleteModelAsync(modelForm.Id!.Value, modelForm.RowVersion!), () => modelForm = new()))">ลบ</MudButton>
                <MudButton OnClick="@(() => modelForm = new())">รายการใหม่</MudButton>
            }
        </MudStack>
        <MudTable Items="models" Dense="true" Hover="true" Class="mt-3" T="ProductModelDto" Breakpoint="Breakpoint.None"
                  OnRowClick="@((TableRowClickEventArgs<ProductModelDto> e) => modelForm = new() { Id = e.Item!.Id, Name = e.Item.Name, RowVersion = e.Item.RowVersion })">
            <HeaderContent><MudTh>รุ่น</MudTh></HeaderContent>
            <RowTemplate><MudTd>@context.Name</MudTd></RowTemplate>
            <NoRecordsContent><MudText>ยังไม่มีรุ่น</MudText></NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="กลุ่มสินค้า">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="groupForm.Pattern" Label="รหัสกลุ่ม" MaxLength="ProductRegistry.GroupPatternLength" Style="max-width:12rem" HelperText="เช่น G1* · * = ทั้งหมด" />
            <MudTextField @bind-Value="groupForm.Name" Label="ชื่อกลุ่ม" MaxLength="ProductRegistry.TextLength" Style="min-width:16rem" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="@(() => RunAsync(r => r.SaveGroupAsync(groupForm.Id, groupForm.Pattern, groupForm.Name, groupForm.RowVersion), () => groupForm = new()))">บันทึก</MudButton>
            @if (groupForm.Id is not null)
            {
                <MudButton Color="Color.Error" Disabled="busy" OnClick="@(() => ConfirmDeleteAsync($"กลุ่มสินค้า {groupForm.Pattern}", r => r.DeleteGroupAsync(groupForm.Id!.Value, groupForm.RowVersion!), () => groupForm = new()))">ลบ</MudButton>
                <MudButton OnClick="@(() => groupForm = new())">รายการใหม่</MudButton>
            }
        </MudStack>
        <MudTable Items="groups" Dense="true" Hover="true" Class="mt-3" T="ProductGroupDto" Breakpoint="Breakpoint.None"
                  OnRowClick="@((TableRowClickEventArgs<ProductGroupDto> e) => groupForm = new() { Id = e.Item!.Id, Pattern = e.Item.Pattern, Name = e.Item.Name, RowVersion = e.Item.RowVersion })">
            <HeaderContent><MudTh>รหัสกลุ่ม</MudTh><MudTh>ชื่อกลุ่ม</MudTh></HeaderContent>
            <RowTemplate><MudTd>@context.Pattern</MudTd><MudTd>@context.Name</MudTd></RowTemplate>
            <NoRecordsContent><MudText>ยังไม่มีกลุ่มสินค้า</MudText></NoRecordsContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>

<MudButton Href="order/products" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับหน้าข้อมูลสินค้า</MudButton>

@code {
    private IReadOnlyList<ProductTypeDto> types = [];
    private IReadOnlyList<BrakeTypeDto> brakeTypes = [];
    private IReadOnlyList<ProductModelDto> models = [];
    private IReadOnlyList<ProductGroupDto> groups = [];
    private Form typeForm = new(), brakeForm = new(), modelForm = new(), groupForm = new();
    private bool busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
        => (types, brakeTypes, models, groups) = await Services.RunAsync<ProductDirectory,
            (IReadOnlyList<ProductTypeDto>, IReadOnlyList<BrakeTypeDto>, IReadOnlyList<ProductModelDto>, IReadOnlyList<ProductGroupDto>)>(
            async d => (await d.GetProductTypesAsync(), await d.GetBrakeTypesAsync(), await d.GetModelsAsync(), await d.GetGroupsAsync()));

    private async Task ConfirmDeleteAsync(string what, Func<ProductListRegistry, Task<ServiceResult>> action, Action reset)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("ลบรายการ", $"ลบ{what}?", yesText: "ลบ", cancelText: "ยกเลิก");
        if (confirmed == true) await RunAsync(action, reset);
    }

    private async Task RunAsync(Func<ProductListRegistry, Task<ServiceResult>> action, Action reset)
    {
        busy = true;
        try
        {
            var result = await Services.RunAsync(action);
            foreach (var error in result.Errors) Snackbar.Add(error, Severity.Error);
            if (!result.Succeeded) return;
            Snackbar.Add("บันทึกแล้ว", Severity.Success);
            reset();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            reset();
        }
        finally
        {
            busy = false;
            await ReloadAsync();
        }
    }

    private sealed class Form
    {
        public int? Id { get; set; }
        public string Code { get; set; } = "";
        public string Pattern { get; set; } = "";
        public string Name { get; set; } = "";
        public byte[]? RowVersion { get; set; }
    }
}
