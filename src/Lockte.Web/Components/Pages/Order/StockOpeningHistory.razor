@page "/order/stock/opening-history"
@attribute [Authorize]
@using System.Globalization
@using Lockte.Prod
@using Lockte.SharedKernel
@using Lockte.Web.Reports.Order
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ScopedServices Services
@inject ProtectedLocalStorage Storage

@* RPT-14 พิมพ์สรุปสต็อก (พิมพ์สรุปSTOCK, #123): the opening balances of every cut in a range, a row for each product (a กลุ่มรหัส narrows it) and a column for each cut date. The legacy opened a crosstab on the
   screen; here the table is shown below, printed, or downloaded as Excel. The range and the group are remembered in this browser (BR-022). *@
<PageTitle>สรุปสต็อกยกมารายงวด — LOCKTE</PageTitle>
<h1 class="mb-4">สรุปสต็อกสินค้ายกมารายงวด</h1>

<MudPaper Class="pa-4" Outlined="true" Style="max-width:60rem">
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
        <MudDatePicker Editable="true" @bind-Date="from" @bind-Date:after="RememberAsync" Label="ตั้งแต่วันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:16rem" />
        <MudDatePicker Editable="true" @bind-Date="to" @bind-Date:after="RememberAsync" Label="ถึงวันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:16rem" />
        <MudTextField @bind-Value="pattern" @bind-Value:after="RememberAsync" Label="กลุ่มรหัสสินค้า (เช่น SB* — ว่าง = ทั้งหมด)" Clearable="true" Style="max-width:22rem" />
    </MudStack>
    @if (Problem is { } problem)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@problem</MudAlert>
    }
    <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowAsync" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.TableView">แสดง</MudButton>
        <MudButton Variant="Variant.Outlined" Href="@Url(null)" Target="_blank" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.Print">พิมพ์</MudButton>
        <MudButton Variant="Variant.Outlined" Href="@Url("xlsx")" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.FileDownload">Excel</MudButton>
    </MudStack>
</MudPaper>

@if (table is not null)
{
    <MudPaper Class="pa-4 mt-4" Outlined="true" Style="overflow-x:auto">
        @if (table.Rows.Count == 0)
        {
            <MudText>ไม่มีข้อมูล</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr>@foreach (var column in table.Columns) { <th style="@(column.Format == SummaryFormat.Text ? null : "text-align:right")">@column.Header</th> }</tr></thead>
                <tbody>
                    @foreach (var row in table.Rows)
                    {
                        <tr>@for (var c = 0; c < table.Columns.Count; c++) { <td style="@(table.Columns[c].Format == SummaryFormat.Text ? null : "text-align:right")">@SummaryTable.Show(table.Columns[c], row[c])</td> }</tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

<MudButton Href="@OrderMenu.HrefOf(4)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private DateTime? from = new(DateTime.Today.Year, 1, 1);
    private DateTime? to = new(DateTime.Today.Year, 12, 31);
    private string? pattern;
    private SummaryTable? table;
    private bool loadedMemory;

    private string? Problem => from is null || to is null ? "กรุณากรอกตั้งแต่วันที่และถึงวันที่" : from > to ? "ตั้งแต่วันที่ต้องไม่หลังถึงวันที่" : null;

    private string Url(string? format)
        => $"/reports/order/stock/opening-history?from={from?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}&to={to?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}"
            + (string.IsNullOrWhiteSpace(pattern) ? "" : "&pattern=" + Uri.EscapeDataString(pattern.Trim())) + (format is null ? "" : "&format=" + format);

    private async Task ShowAsync()
    {
        var (f, t, p) = (DateOnly.FromDateTime(from!.Value), DateOnly.FromDateTime(to!.Value), pattern);
        table = await Services.RunAsync<StockClosingDirectory, SummaryTable>(d => StockCutReports.OpeningHistoryAsync(d, f, t, p));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedMemory) return;
        loadedMemory = true;
        try
        {
            if (await Storage.GetAsync<Remembered>("order.stock-opening") is { Success: true, Value: { } saved })
            {
                from = saved.From?.ToDateTime(TimeOnly.MinValue) ?? from;
                to = saved.To?.ToDateTime(TimeOnly.MinValue) ?? to;
                pattern = saved.Pattern;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Nothing remembered (or unreadable): keep the year.
        }
    }

    private async Task RememberAsync()
    {
        try { await Storage.SetAsync("order.stock-opening", new Remembered(from is { } f ? DateOnly.FromDateTime(f) : null, to is { } t ? DateOnly.FromDateTime(t) : null, pattern)); }
        catch (Exception) { /* remembering is a convenience only */ }
    }

    private sealed record Remembered(DateOnly? From, DateOnly? To, string? Pattern);
}
