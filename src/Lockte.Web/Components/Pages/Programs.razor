@page "/programs"
@attribute [Authorize]

@* หน้าเลือกโปรแกรม: one card per program in this app. MainLayout remembers the one opened, so the next login goes
   straight there (Start); the program switcher in the app bar comes back here. *@
<PageTitle>เลือกโปรแกรม — LOCKTE</PageTitle>
<div class="menu-page program-page">
    <img src="brand/logo.svg" alt="LOCKTE" class="menu-logo" />
    <h1 class="menu-title">เลือกโปรแกรม</h1>
    <div class="program-cards">
        @foreach (var (program, icon, detail) in Cards)
        {
            <a href="@program.Root" class="program-card">
                <MudIcon Icon="@icon" Class="program-card-icon" />
                <span class="program-card-title">@program.Title</span>
                <span class="program-card-detail">@detail</span>
            </a>
        }
    </div>
</div>

@code {
    private static readonly (ProgramMenu Program, string Icon, string Detail)[] Cards =
    [
        (EmployeeMenu.Menu, Icons.Material.Filled.Badge, "ข้อมูลพนักงาน เวลาทำงาน การลา ปิดงวดค่าแรง"),
        (OrderMenu.Menu, Icons.Material.Filled.Factory, "ลูกค้า สินค้า ORDER การส่งของ ผลผลิต แม่พิมพ์ QA"),
        (PurchMenu.Menu, Icons.Material.Filled.Inventory2, "ผู้ขาย วัตถุดิบ ใบสั่งซื้อ รับวัตถุดิบ ประเมินผู้ขาย สต็อกวัตถุดิบ"),
        (CalibMenu.Menu, Icons.Material.Filled.Straighten, "เครื่องมือวัด 6 ชนิด แผนและบัญชีรายชื่อ สติกเกอร์ ใบตรวจ JIG"),
        (CashMenu.Menu, Icons.Material.Filled.Payments, "ค่าใช้จ่ายเงินสดย่อย ใบสำคัญจ่าย ขายของเก่า ยอดรอนำส่ง"),
    ];
}
