@page "/programs"
@attribute [Authorize]

@* หน้าเลือกโปรแกรม: one card per program in this app. MainLayout remembers the one opened, so the next login goes
   straight there (Start); the program switcher in the app bar comes back here. *@
<PageTitle>เลือกโปรแกรม — LOCKTE</PageTitle>
<div class="menu-page program-page">
    <img src="brand/logo.svg" alt="LOCKTE" class="menu-logo" />
    <h1 class="menu-title">เลือกโปรแกรม</h1>
    @if (cards.Count == 0)
    {
        @* ADR 0005 *@
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            user นี้ยังไม่มีสิทธิ์เข้าโปรแกรมใด — ติดต่อผู้ดูแลระบบ
        </MudAlert>
    }
    <div class="program-cards">
        @foreach (var (program, detail) in cards)
        {
            <a href="@program.Root" class="program-card">
                <MudIcon Icon="@program.Icon" Class="program-card-icon" />
                <span class="program-card-title">@program.Title</span>
                <span class="program-card-detail">@detail</span>
            </a>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    // ADR 0005: only the programs this user may open.
    private IReadOnlyList<(ProgramMenu Program, string Detail)> cards = [];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        cards = Cards.Where(c => AccountClaims.CanUseProgram(user, c.Program.Key)).ToList();
    }

    private static readonly (ProgramMenu Program, string Detail)[] Cards =
    [
        (EmployeeMenu.Menu, "ข้อมูลพนักงาน เวลาทำงาน การลา ปิดงวดค่าแรง"),
        (OrderMenu.Menu, "ลูกค้า สินค้า ORDER การส่งของ ผลผลิต แม่พิมพ์ QA"),
        (PurchMenu.Menu, "ผู้ขาย วัตถุดิบ ใบสั่งซื้อ รับวัตถุดิบ ประเมินผู้ขาย สต็อกวัตถุดิบ"),
        (CalibMenu.Menu, "เครื่องมือวัด 6 ชนิด แผนและบัญชีรายชื่อ สติกเกอร์ ใบตรวจ JIG"),
        (CashMenu.Menu, "ค่าใช้จ่ายเงินสดย่อย ใบสำคัญจ่าย ขายของเก่า ยอดรอนำส่ง"),
    ];
}
