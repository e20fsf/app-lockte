@page "/purch/reports/evaluation"
@attribute [Authorize]
@using System.Globalization
@using Lockte.Purch
@using Lockte.SharedKernel
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ScopedServices Services
@inject ProtectedLocalStorage Storage
@inject TimeProvider Clock

@* พิมพ์แบบผลการประเมินติดตามผู้ขายประจำไตรมาส (SCR-20 → RPT-07, BR-050, BR-081): the period, the supplier (only those ใช้ในการผลิต), the date of the evaluation, the quarter and the
   two service points. "พิมพ์" counts the receipts that have a LOT, keeps the result for the quarter and opens the form. What was typed last is remembered in this browser, per screen. *@
<PageTitle>พิมพ์แบบผลการประเมินติดตามผู้ขายประจำไตรมาส — LOCKTE</PageTitle>
<h1 class="mb-4">พิมพ์แบบผลการประเมินติดตามผู้ขายประจำไตรมาส</h1>

<MudPaper Class="pa-4" Outlined="true" Style="max-width:48rem">
    <MudStack Spacing="2">
        <MudStack Row="true" Spacing="2">
            <MudDatePicker Editable="true" @bind-Date="from" @bind-Date:after="RememberAsync" Label="ตั้งแต่วันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:16rem" />
            <MudDatePicker Editable="true" @bind-Date="to" @bind-Date:after="RememberAsync" Label="ถึงวันที่" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:16rem" />
        </MudStack>
        <SupplierPicker Value="supplier" ValueChanged="@(async (SupplierDto? s) => { supplier = s; await RememberAsync(); })" ProductionOnly="true" Label="ผู้ขาย (ที่ใช้ในการผลิต)" />
        <MudStack Row="true" Spacing="2">
            <MudDatePicker Editable="true" @bind-Date="evaluationDate" @bind-Date:after="RememberAsync" Label="วันที่ประเมิน" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:16rem" />
            <MudSelect T="int" @bind-Value="quarter" @bind-Value:after="RememberAsync" Label="ไตรมาสที่" Style="max-width:10rem">
                @for (var q = 1; q <= 4; q++)
                {
                    <MudSelectItem T="int" Value="q">@q</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudSelect T="int" @bind-Value="point1" @bind-Value:after="RememberAsync" Label="คะแนนบริการ 1 (รับฟัง-ตอบปัญหา)" Style="max-width:22rem">
                @for (var p = 5; p >= 1; p--)
                {
                    <MudSelectItem T="int" Value="p">@p — @SupplierScore.Service1Text(p)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int" @bind-Value="point2" @bind-Value:after="RememberAsync" Label="คะแนนบริการ 2 (ตอบสนองข้อร้องเรียน)" Style="max-width:22rem">
                @for (var p = 5; p >= 1; p--)
                {
                    <MudSelectItem T="int" Value="p">@p — @SupplierScore.Service2Text(p)</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </MudStack>
    @if (Problem is { } problem)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@problem</MudAlert>
    }
    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@Url" Target="_blank" Disabled="@(Problem is not null)" StartIcon="@Icons.Material.Filled.Print">พิมพ์</MudButton>
    </MudStack>
</MudPaper>

<MudButton Href="@PurchMenu.HrefOf(7)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private DateTime? from;
    private DateTime? to;
    private DateTime? evaluationDate;
    private SupplierDto? supplier;
    private int quarter = 1;
    private int point1 = 5;
    private int point2 = 5;
    private bool loadedMemory;

    private string? Problem
    {
        get
        {
            if (from is null || to is null) return "กรุณากรอกตั้งแต่วันที่และถึงวันที่";
            if (from > to) return "ตั้งแต่วันที่ต้องไม่หลังถึงวันที่";
            if (supplier is null) return "กรุณาเลือกผู้ขาย";
            return null;
        }
    }

    private string Url
        => $"/reports/purch/evaluation?supplier={supplier?.Id}&from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}&quarter={quarter}&date={evaluationDate:yyyy-MM-dd}&point1={point1}&point2={point2}";

    protected override void OnInitialized()
    {
        var today = Clock.GetLocalNow().DateTime.Date;
        quarter = (today.Month - 1) / 3 + 1;
        from = new DateTime(today.Year, (quarter - 1) * 3 + 1, 1);
        to = from.Value.AddMonths(3).AddDays(-1);
        evaluationDate = today;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedMemory) return;
        loadedMemory = true;
        try
        {
            if (await Storage.GetAsync<Remembered>("purch.evaluation") is { Success: true, Value: { } saved })
            {
                from = saved.From?.ToDateTime(TimeOnly.MinValue) ?? from;
                to = saved.To?.ToDateTime(TimeOnly.MinValue) ?? to;
                evaluationDate = saved.EvaluationDate?.ToDateTime(TimeOnly.MinValue) ?? evaluationDate;
                quarter = saved.Quarter is >= 1 and <= 4 ? saved.Quarter : quarter;
                point1 = saved.Point1 is >= 1 and <= 5 ? saved.Point1 : point1;
                point2 = saved.Point2 is >= 1 and <= 5 ? saved.Point2 : point2;
                if (saved.SupplierId is { } id) supplier = await Services.RunAsync<SupplierDirectory, SupplierDto?>(d => d.GetAsync(id));
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Nothing remembered (or unreadable): keep the defaults.
        }
    }

    private async Task RememberAsync()
    {
        try
        {
            await Storage.SetAsync("purch.evaluation", new Remembered(from is { } f ? DateOnly.FromDateTime(f) : null, to is { } t ? DateOnly.FromDateTime(t) : null,
                evaluationDate is { } e ? DateOnly.FromDateTime(e) : null, supplier?.Id, quarter, point1, point2));
        }
        catch (Exception)
        {
            // remembering is a convenience only
        }
    }

    private sealed record Remembered(DateOnly? From, DateOnly? To, DateOnly? EvaluationDate, int? SupplierId, int Quarter, int Point1, int Point2);
}
