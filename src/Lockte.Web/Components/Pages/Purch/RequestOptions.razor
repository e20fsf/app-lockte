@page "/purch/request-options"
@attribute [Authorize]
@using Lockte.Purch
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar

@* ตัวเลือกของใบขอซื้อ (#216): ผู้จัดซื้อ (สถานที่ที่ออกใบสั่งซื้อ), เหตุผลในการขอซื้อ and หมายเหตุ. The request form also takes free text for the last two. *@
<PageTitle>ผู้จัดซื้อ เหตุผล และหมายเหตุของใบขอซื้อ — LOCKTE</PageTitle>
<h1 class="mb-4">ผู้จัดซื้อ เหตุผล และหมายเหตุของใบขอซื้อ</h1>

@if (locations is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Outlined="true" Class="pa-4 mb-3" Style="max-width:48rem">
        <MudText Typo="Typo.h6">ผู้จัดซื้อ</MudText>
        <MudText Typo="Typo.caption">สถานที่ที่ออกใบสั่งซื้อ (โรงงาน, สำนักงานสีลม) ไม่ใช่ตัวบุคคล</MudText>
        @foreach (var l in locations)
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-1">
                <MudTextField @bind-Value="l.Code" Label="รหัส" MaxLength="RequestSetupRegistry.PrefixLength" Style="max-width:8rem" />
                <MudTextField @bind-Value="l.Name" Label="ชื่อ" MaxLength="RequestSetupRegistry.NameLength" Style="max-width:20rem" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => locations.Remove(l))" aria-label="ลบ" />
            </MudStack>
        }
        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => locations.Add(new LocationRow()))" Class="mt-1">เพิ่มผู้จัดซื้อ</MudButton>
        <div><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLocationsAsync" Disabled="busy" Class="mt-2">บันทึกผู้จัดซื้อ</MudButton></div>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-3" Style="max-width:48rem">
        <MudText Typo="Typo.h6">เหตุผลในการขอซื้อ (@reasons.Count รายการ)</MudText>
        <MudTextField @bind-Value="reasonsText" Lines="8" Label="หนึ่งบรรทัดต่อหนึ่งข้อความ" MaxLength="200000" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveReasonsAsync" Disabled="busy" Class="mt-2">บันทึกเหตุผล</MudButton>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4 mb-3" Style="max-width:48rem">
        <MudText Typo="Typo.h6">หมายเหตุ (@notes.Count รายการ)</MudText>
        <MudTextField @bind-Value="notesText" Lines="5" Label="หนึ่งบรรทัดต่อหนึ่งข้อความ" MaxLength="200000" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveNotesAsync" Disabled="busy" Class="mt-2">บันทึกหมายเหตุ</MudButton>
    </MudPaper>
}

<MudButton Href="purch/departments" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับหน้าแผนก</MudButton>

@code {
    private List<LocationRow>? locations;
    private List<string> reasons = [];
    private List<string> notes = [];
    private string reasonsText = "";
    private string notesText = "";
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        locations = (await Services.RunAsync<RequestSetupDirectory, IReadOnlyList<PurchasingLocationDto>>(d => d.GetLocationsAsync()))
            .Select(l => new LocationRow { Code = l.Code, Name = l.Name }).ToList();
        reasons = (await Services.RunAsync<RequestSetupDirectory, IReadOnlyList<string>>(d => d.GetReasonsAsync())).ToList();
        notes = (await Services.RunAsync<RequestSetupDirectory, IReadOnlyList<string>>(d => d.GetNotesAsync())).ToList();
        reasonsText = string.Join("\n", reasons);
        notesText = string.Join("\n", notes);
    }

    private static List<string> Lines(string text)
        => text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct().ToList();

    private Task SaveLocationsAsync()
    {
        var list = locations!.Select(l => new PurchasingLocationDto(l.Code ?? "", l.Name ?? "")).ToList();
        return RunAsync(r => r.SaveLocationsAsync(list), "บันทึกผู้จัดซื้อแล้ว");
    }

    private async Task SaveReasonsAsync()
    {
        var list = Lines(reasonsText);
        await RunAsync(r => r.SaveReasonsAsync(list), "บันทึกเหตุผลแล้ว");
        reasons = list;
    }

    private async Task SaveNotesAsync()
    {
        var list = Lines(notesText);
        await RunAsync(r => r.SaveNotesAsync(list), "บันทึกหมายเหตุแล้ว");
        notes = list;
    }

    private async Task RunAsync(Func<RequestSetupRegistry, Task<ServiceResult>> save, string done)
    {
        busy = true;
        try
        {
            var result = await Services.RunAsync<RequestSetupRegistry, ServiceResult>(save);
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (result.Succeeded) Snackbar.Add(done, Severity.Success);
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class LocationRow
    {
        public string? Code { get; set; }
        public string? Name { get; set; }
    }
}
