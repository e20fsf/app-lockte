@page "/purch/suppliers"
@page "/purch/suppliers/new"
@attribute [Authorize]
@using Lockte.Purch
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* ผู้ขาย (SCR-02, BR-002): เพิ่ม (ฟอร์ม SP) and แก้ไข (SP1/SP2) on one page — pick a row of the list to edit it, "รายต่อไป" for a
   new one. Unlike the legacy the code cannot repeat (AC-32) and a supplier is deleted with a button and a confirmation, not by
   clearing its name. The print buttons (RPT-30…33) come with #263/#264. *@
<PageTitle>ผู้ขาย — LOCKTE</PageTitle>
<h1 class="mb-4">ผู้ขาย</h1>

<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">@(form.Id is null ? "เพิ่มผู้ขาย" : $"แก้ผู้ขาย {form.Code}")</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="form.Code" Label="รหัสผู้ขาย" MaxLength="SupplierRegistry.CodeLength" Required="true" RequiredError="กรุณากรอกรหัสผู้ขาย" /></MudItem>
        <MudItem xs="12" sm="9"><MudTextField @bind-Value="form.Name" Label="ชื่อผู้ขาย" MaxLength="SupplierRegistry.TextLength" Required="true" RequiredError="กรุณากรอกชื่อผู้ขาย" /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="form.Address1" Label="ที่อยู่" MaxLength="SupplierRegistry.TextLength" /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="form.Address2" Label="เขต(อำเภอ)และจังหวัด" MaxLength="SupplierRegistry.TextLength" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="form.Tel1" Label="โทรศัพท์ 1" MaxLength="SupplierRegistry.TextLength" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="form.Tel2" Label="โทรศัพท์ 2" MaxLength="SupplierRegistry.TextLength" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="form.Fax" Label="แฟกซ์" MaxLength="SupplierRegistry.TextLength" /></MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="form.Contact" Label="ผู้ติดต่อ" MaxLength="SupplierRegistry.TextLength" /></MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="int?" @bind-Value="form.CreditDays" Label="เครดิต (วัน)" Clearable="true">
                @foreach (var d in CreditChoices)
                {
                    <MudSelectItem T="int?" Value="@((int?)d)">@SupplierCredit.Text(d)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="bool" @bind-Value="form.Vat" Label="VAT">
                <MudSelectItem T="bool" Value="true">YES</MudSelectItem>
                <MudSelectItem T="bool" Value="false">NO</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6"><MudTextField @bind-Value="form.ProductType" Label="ประเภทผลิตภัณฑ์" MaxLength="SupplierRegistry.TextLength" /></MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" @bind-Value="form.BusinessType" Label="ประเภทธุรกิจ" Clearable="true">
                @foreach (var t in BusinessChoices)
                {
                    <MudSelectItem T="string" Value="t">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="bool" @bind-Value="form.Certificate" Label="ใบรับรอง">
                <MudSelectItem T="bool" Value="true">มี</MudSelectItem>
                <MudSelectItem T="bool" Value="false">ไม่มี</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="bool" @bind-Value="form.UsedInProduction" Label="ใช้ในการผลิต">
                <MudSelectItem T="bool" Value="true">ใช่</MudSelectItem>
                <MudSelectItem T="bool" Value="false">ไม่ใช่</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
    <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy">บันทึก</MudButton>
        <MudButton OnClick="New" StartIcon="@Icons.Material.Filled.Add">รายต่อไป</MudButton>
        @if (form.Id is not null)
        {
            <MudSpacer />
            <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="busy" StartIcon="@Icons.Material.Filled.Delete">ลบผู้ขายนี้</MudButton>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
        <MudText Typo="Typo.h6">รายชื่อผู้ขาย</MudText>
        <MudTextField @bind-Value="search" Immediate="true" Label="ค้นหา (รหัสหรือชื่อ)" Clearable="true" Margin="Margin.Dense" Style="max-width:18rem" />
    </MudStack>
    <MudTable Items="Shown" Dense="true" Hover="true" Loading="suppliers is null" T="SupplierDto" Breakpoint="Breakpoint.None"
              OnRowClick="@((TableRowClickEventArgs<SupplierDto> e) => Edit(e.Item!))">
        <HeaderContent><MudTh>รหัส</MudTh><MudTh>ชื่อ</MudTh><MudTh>โทรศัพท์</MudTh><MudTh>เครดิต</MudTh><MudTh>VAT</MudTh><MudTh>ใช้ในการผลิต</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Tel1</MudTd>
            <MudTd>@context.CreditText</MudTd>
            <MudTd>@(context.Vat ? "YES" : "NO")</MudTd>
            <MudTd>@(context.UsedInProduction ? "ใช่" : "ไม่ใช่")</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>ไม่พบผู้ขาย</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

<MudStack Row="true" Spacing="2" Class="mt-4">
    <MudButton Variant="Variant.Outlined" Href="purch/suppliers/options" StartIcon="@Icons.Material.Filled.Tune">แก้ตัวเลือกเครดิตและประเภทธุรกิจ</MudButton>
</MudStack>

<MudButton Href="@PurchMenu.HrefOf(9)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private IReadOnlyList<SupplierDto>? suppliers;
    private IReadOnlyList<int> creditOptions = [];
    private IReadOnlyList<string> businessOptions = [];
    private SupplierForm form = new();
    private string? search;
    private bool busy;

    /// <summary>The options, plus the value of the row being edited when it is no longer among them (the legacy has a 15-day credit).</summary>
    private IEnumerable<int> CreditChoices => form.CreditDays is { } d && !creditOptions.Contains(d) ? creditOptions.Append(d) : creditOptions;

    private IEnumerable<string> BusinessChoices => form.BusinessType is { } t && !businessOptions.Contains(t) ? businessOptions.Append(t) : businessOptions;

    private IEnumerable<SupplierDto> Shown => (suppliers ?? [])
        .Where(s => string.IsNullOrWhiteSpace(search)
            || s.Code.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || s.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        creditOptions = await Services.RunAsync<SupplierDirectory, IReadOnlyList<int>>(d => d.GetCreditOptionsAsync());
        businessOptions = await Services.RunAsync<SupplierDirectory, IReadOnlyList<string>>(d => d.GetBusinessTypesAsync());
        await ReloadAsync();
    }

    private async Task ReloadAsync()
        => suppliers = await Services.RunAsync<SupplierDirectory, IReadOnlyList<SupplierDto>>(d => d.GetAllAsync());

    private void New() => form = new SupplierForm();

    private void Edit(SupplierDto s) => form = new SupplierForm
    {
        Id = s.Id, Code = s.Code, Name = s.Name, Address1 = s.Address1, Address2 = s.Address2, Tel1 = s.Tel1, Tel2 = s.Tel2, Fax = s.Fax,
        Contact = s.Contact, CreditDays = s.CreditDays, Vat = s.Vat, ProductType = s.ProductType, BusinessType = s.BusinessType,
        Certificate = s.Certificate, UsedInProduction = s.UsedInProduction, RowVersion = s.RowVersion,
    };

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var input = new SupplierInput(form.Id, form.Code, form.Name, form.RowVersion, form.Address1, form.Address2, form.Tel1, form.Tel2,
                form.Fax, form.Contact, form.CreditDays, form.Vat, form.ProductType, form.BusinessType, form.Certificate, form.UsedInProduction);
            var result = await Services.RunAsync<SupplierRegistry, ServiceResult>(r => r.SaveAsync(input));
            foreach (var error in result.Errors) Snackbar.Add(error, Severity.Error);
            if (!result.Succeeded) return;

            Snackbar.Add("บันทึกแล้ว", Severity.Success);
            New();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            New();
        }
        finally
        {
            busy = false;
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("ลบผู้ขาย", $"ลบผู้ขาย {form.Code} {form.Name}?", yesText: "ลบ", cancelText: "ยกเลิก");
        if (confirmed != true) return;
        busy = true;
        try
        {
            var (id, rowVersion) = (form.Id!.Value, form.RowVersion!);
            var result = await Services.RunAsync<SupplierRegistry, ServiceResult>(r => r.DeleteAsync(id, rowVersion));
            foreach (var error in result.Errors) Snackbar.Add(error, Severity.Error);
            if (!result.Succeeded) return;
            Snackbar.Add("ลบแล้ว", Severity.Success);
            New();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            New();
        }
        finally
        {
            busy = false;
            await ReloadAsync();
        }
    }

    private sealed class SupplierForm
    {
        public int? Id { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Address1 { get; set; }
        public string? Address2 { get; set; }
        public string? Tel1 { get; set; }
        public string? Tel2 { get; set; }
        public string? Fax { get; set; }
        public string? Contact { get; set; }
        public int? CreditDays { get; set; }
        public bool Vat { get; set; }
        public string? ProductType { get; set; }
        public string? BusinessType { get; set; }
        public bool Certificate { get; set; }
        public bool UsedInProduction { get; set; }
        public byte[]? RowVersion { get; set; }
    }
}
