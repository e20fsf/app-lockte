@page "/purch/materials"
@page "/purch/materials/new"
@attribute [Authorize]
@using Lockte.Prod
@using Lockte.Purch
@using Lockte.SharedKernel
@using Lockte.SharedKernel.Persistence
@inject ScopedServices Services
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* วัตถุดิบ (SCR-17, BR-001): เพิ่ม (ฟอร์ม MTR_NAME) and แก้ไข (MTR_NAME1/2) on one page — pick a row to edit it, "รายต่อไป" for a new one.
   The code cannot repeat (AC-31); a material is deleted with a button and a confirmation, not by clearing its name. The latest supplier is
   filled by the goods receipt and only shown. The list prints (RPT-28/29) are the buttons below the list. *@
<PageTitle>วัตถุดิบ — LOCKTE</PageTitle>
<h1 class="mb-4">วัตถุดิบ</h1>

<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-2">@(form.Id is null ? "เพิ่มวัตถุดิบ" : $"แก้วัตถุดิบ {form.Code}")</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="form.Code" Label="รหัสวัตถุดิบ" MaxLength="MaterialRegistry.CodeLength" Required="true" RequiredError="กรุณากรอกรหัสวัตถุดิบ" /></MudItem>
        <MudItem xs="12" sm="9">
            <MudTextField @bind-Value="form.Name" Label="ชื่อวัตถุดิบ" MaxLength="MaterialRegistry.NameLength" Required="true" RequiredError="กรุณากรอกชื่อวัตถุดิบ" Immediate="true"
                          HelperText="@(form.Name.Trim().Length > MaterialRegistry.NameAdvice ? $"ยาว {form.Name.Trim().Length} ตัว — ไม่ควรเกิน {MaterialRegistry.NameAdvice} ตัวอักษรรวมเว้นวรรค (ให้พอดีช่องในใบสั่งซื้อ)" : $"ไม่ควรเกิน {MaterialRegistry.NameAdvice} ตัวอักษรรวมเว้นวรรค")" />
        </MudItem>
        <MudItem xs="12" sm="3"><MudTextField @bind-Value="form.Unit" Label="หน่วย" MaxLength="MaterialRegistry.UnitLength" /></MudItem>
        <MudItem xs="12" sm="3"><MudNumericField T="decimal" @bind-Value="form.Cost" Label="ราคาล่าสุด (บาท ไม่รวม VAT)" Min="0" /></MudItem>
        <MudItem xs="12" sm="3"><MudNumericField T="decimal?" @bind-Value="form.MinimumQuantity" Label="จุดสั่งซื้อต่ำสุด" Min="0" /></MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="bool" @bind-Value="form.IsMain" Label="เป็นวัตถุดิบหลัก" HelperText="ใช้ผลิตผ้าเบรก ดิสเบรก ผ้าคลัทช์โดยเฉพาะ">
                <MudSelectItem T="bool" Value="true">ใช่</MudSelectItem>
                <MudSelectItem T="bool" Value="false">ไม่ใช่</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="form.BuyBackPrice" Label="ซื้อคืน กก.ละ" Min="0" HelperText="ใส่เฉพาะอลูมิเนียมหลอมคืน วัตถุดิบอื่นไม่ต้องใส่" /></MudItem>
        <MudItem xs="12" sm="4">
            <MudAutocomplete T="ProductListItem" @bind-Value="form.Product" SearchFunc="SearchProductsAsync" Label="สินค้า (เฉพาะสินค้าซื้อมาขาย)"
                             ToStringFunc="@(p => p is null ? "" : $"{p.Code}  {p.Name}")" Clearable="true" ResetValueOnEmptyText="true" MaxItems="50" />
        </MudItem>
        <MudItem xs="12" sm="4"><MudTextField Value="@form.LatestSupplier" Label="ผู้ขายล่าสุด" ReadOnly="true" HelperText="เติมจากการรับของ" /></MudItem>
    </MudGrid>
    <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="busy">บันทึก</MudButton>
        <MudButton OnClick="New" StartIcon="@Icons.Material.Filled.Add">รายต่อไป</MudButton>
        @if (form.Id is not null)
        {
            <MudSpacer />
            <MudButton Color="Color.Error" OnClick="DeleteAsync" Disabled="busy" StartIcon="@Icons.Material.Filled.Delete">ลบวัตถุดิบนี้</MudButton>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
        <MudText Typo="Typo.h6">รายชื่อวัตถุดิบ</MudText>
        <MudSelect T="string" @bind-Value="group" Label="กลุ่มรหัส" Clearable="true" Margin="Margin.Dense" Style="max-width:12rem">
            @foreach (var g in groups)
            {
                <MudSelectItem T="string" Value="g">@g*</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="search" Immediate="true" Label="ค้นหา (รหัสหรือชื่อ)" Clearable="true" Margin="Margin.Dense" Style="max-width:18rem" />
    </MudStack>
    <MudTable Items="Shown" Dense="true" Hover="true" Loading="materials is null" T="MaterialDto" Breakpoint="Breakpoint.None"
              OnRowClick="@((TableRowClickEventArgs<MaterialDto> e) => Edit(e.Item!))" Virtualize="true" FixedHeader="true" Height="28rem">
        <HeaderContent><MudTh>รหัส</MudTh><MudTh>ชื่อ</MudTh><MudTh>หน่วย</MudTh><MudTh>ราคา</MudTh><MudTh>หลัก</MudTh><MudTh>ผู้ขายล่าสุด</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Unit</MudTd>
            <MudTd>@context.Cost.ToString("N2")</MudTd>
            <MudTd>@(context.IsMain ? "ใช่" : "")</MudTd>
            <MudTd>@context.LatestSupplierName</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>ไม่พบวัตถุดิบ</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

<MudStack Row="true" Spacing="2" Class="mt-4">
    <MudButton Variant="Variant.Outlined" Href="purch/materials/groups" StartIcon="@Icons.Material.Filled.Tune">แก้กลุ่มรหัสวัตถุดิบ</MudButton>
    <MudButton Variant="Variant.Outlined" Href="@($"reports/purch/lists/materials?group={Uri.EscapeDataString(group ?? "")}")" Target="_blank" StartIcon="@Icons.Material.Filled.Print">พิมพ์รายชื่อตามรหัส@(string.IsNullOrEmpty(group) ? "" : " (กลุ่ม " + group + "*)")</MudButton>
    <MudButton Variant="Variant.Outlined" Href="reports/purch/lists/materials?byName=true" Target="_blank" StartIcon="@Icons.Material.Filled.Print">พิมพ์รายชื่อตามชื่อ (ทั้งหมด)</MudButton>
</MudStack>

<MudButton Href="@PurchMenu.HrefOf(10)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private IReadOnlyList<MaterialDto>? materials;
    private IReadOnlyList<string> groups = [];
    private MaterialForm form = new();
    private string? search;
    private string? group;
    private bool busy;

    private IEnumerable<MaterialDto> Shown => (materials ?? [])
        .Where(m => string.IsNullOrEmpty(group) || m.Code.StartsWith(group, StringComparison.OrdinalIgnoreCase))
        .Where(m => string.IsNullOrWhiteSpace(search)
            || m.Code.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || m.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        groups = await Services.RunAsync<MaterialDirectory, IReadOnlyList<string>>(d => d.GetGroupsAsync());
        await ReloadAsync();
    }

    private async Task ReloadAsync()
        => materials = await Services.RunAsync<MaterialDirectory, IReadOnlyList<MaterialDto>>(d => d.GetAllAsync());

    private Task<IEnumerable<ProductListItem>> SearchProductsAsync(string? text, CancellationToken token)
        => Services.RunAsync<ProductDirectory, IEnumerable<ProductListItem>>(async d => await d.SearchAsync(text, max: 50));

    private void New() => form = new MaterialForm();

    private async Task Edit(MaterialDto m)
    {
        ProductListItem? product = null;
        if (m.ProductId is { } productId)
        {
            var p = await Services.RunAsync<ProductDirectory, ProductDto?>(d => d.GetAsync(productId));
            if (p is not null) product = new ProductListItem(p.Id, p.Code, p.Name, p.Unit);
        }
        form = new MaterialForm
        {
            Id = m.Id, Code = m.Code, Name = m.Name, Unit = m.Unit, Cost = m.Cost, MinimumQuantity = m.MinimumQuantity, IsMain = m.IsMain,
            BuyBackPrice = m.BuyBackPrice, Product = product, LatestSupplier = m.LatestSupplierName, RowVersion = m.RowVersion,
        };
    }

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var input = new MaterialInput(form.Id, form.Code, form.Name, form.RowVersion, form.Unit, form.MinimumQuantity, form.Cost, form.IsMain,
                form.BuyBackPrice, form.Product?.Id);
            var result = await Services.RunAsync<MaterialRegistry, ServiceResult>(r => r.SaveAsync(input));
            foreach (var error in result.Errors) Snackbar.Add(error, Severity.Error);
            if (!result.Succeeded) return;

            Snackbar.Add("บันทึกแล้ว", Severity.Success);
            New();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            New();
        }
        finally
        {
            busy = false;
            await ReloadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("ลบวัตถุดิบ", $"ลบวัตถุดิบ {form.Code} {form.Name}?", yesText: "ลบ", cancelText: "ยกเลิก");
        if (confirmed != true) return;
        busy = true;
        try
        {
            var (id, rowVersion) = (form.Id!.Value, form.RowVersion!);
            var result = await Services.RunAsync<MaterialRegistry, ServiceResult>(r => r.DeleteAsync(id, rowVersion));
            foreach (var error in result.Errors) Snackbar.Add(error, Severity.Error);
            if (!result.Succeeded) return;
            Snackbar.Add("ลบแล้ว", Severity.Success);
            New();
        }
        catch (ConcurrencyConflictException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            New();
        }
        finally
        {
            busy = false;
            await ReloadAsync();
        }
    }

    private sealed class MaterialForm
    {
        public int? Id { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Unit { get; set; }
        public decimal Cost { get; set; }
        public decimal? MinimumQuantity { get; set; }
        public bool IsMain { get; set; }
        public decimal BuyBackPrice { get; set; }
        public ProductListItem? Product { get; set; }
        public string? LatestSupplier { get; set; }
        public byte[]? RowVersion { get; set; }
    }
}
