@page "/purch/stock/close"
@attribute [Authorize]
@using Lockte.Purch
@using Lockte.SharedKernel
@inject ScopedServices Services
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject TimeProvider Clock

@* ตัด STOCK วัตถุดิบ (SCR-18, BR-042): the manager of the factory sets the cut date (the end of the month). Every row dated on or before it is closed, the sum of each material is
   carried forward as ยอดยกมา dated that day (the codes of the no-carry prefixes are cleared), and the report of the cut opens. Cutting the same date again gives the same balances.
   A date before the last cut is allowed but warned about. A confirmation comes first — the legacy had none. *@
<PageTitle>ตัดสต็อกวัตถุดิบ — LOCKTE</PageTitle>
<h1 class="mb-4">ตัด STOCK วัตถุดิบ</h1>

<MudAlert Severity="Severity.Warning" Class="mb-3">กำหนดวันที่ตัด STOCK ทุกสิ้นเดือน — <b>ห้ามผู้ที่ไม่มีหน้าที่มาทำการตัด STOCK เองโดยเด็ดขาด</b> (ผู้จัดการโรงงาน)</MudAlert>

<MudPaper Class="pa-4" Outlined="true">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudDatePicker Editable="true" @bind-Date="date" Label="วันที่ตัด" Culture="ThaiDate.Culture" DateFormat="@ThaiDate.Pattern" Style="max-width:14rem" />
        <MudText>วันตัดครั้งก่อน: @(last is { } l ? ThaiDate.Format(l) : "ยังไม่เคยตัด")</MudText>
    </MudStack>
    @if (BeforeLast)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">วันที่ที่เลือกอยู่ก่อนวันตัดครั้งก่อน — ตัดได้ ผลเหมือนเดิม แต่ตรวจวันที่ให้ถูกก่อนกดตัด</MudAlert>
    }
    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="CloseAsync" Disabled="@(busy || date is null)" StartIcon="@Icons.Material.Filled.ContentCut">ตัด STOCK</MudButton>
    </MudStack>
    @if (result is { Succeeded: true } done)
    {
        <MudAlert Severity="Severity.Success" Class="mt-3">ตัดสต็อกวันที่ @ThaiDate.Format(done.Date) แล้ว — ปิด @done.ClosedRows รายการ ยกยอดมา @done.OpeningBalances รหัส</MudAlert>
        <MudButton Variant="Variant.Outlined" Href="@($"/reports/purch/stock-cut?date={done.Date:yyyy-MM-dd}")" Target="_blank" StartIcon="@Icons.Material.Filled.Print" Class="mt-2">พิมพ์รายงานการตัด STOCK</MudButton>
    }
</MudPaper>

@if (cuts.Count > 0)
{
    <MudPaper Class="pa-4 mt-4" Outlined="true">
        <MudText Typo="Typo.h6">วันที่เคยตัด</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            @foreach (var cut in cuts.Take(24))
            {
                <MudChip T="string" Size="Size.Small" Href="@($"/reports/purch/stock-cut?date={cut:yyyy-MM-dd}")" Target="_blank">@ThaiDate.Format(cut)</MudChip>
            }
        </MudStack>
    </MudPaper>
}

<MudButton Href="@PurchMenu.HrefOf(11)" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">กลับเมนูเดิม</MudButton>

@code {
    private DateTime? date;
    private DateOnly? last;
    private IReadOnlyList<DateOnly> cuts = [];
    private StockClosingResult? result;
    private bool busy;

    private bool BeforeLast => date is { } d && last is { } l && DateOnly.FromDateTime(d) < l;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        date = (last?.ToDateTime(TimeOnly.MinValue)) ?? Clock.GetLocalNow().DateTime.Date;
    }

    private async Task ReloadAsync()
    {
        last = await Services.RunAsync<StockClosingDirectory, DateOnly?>(d => d.GetLastCutDateAsync());
        cuts = await Services.RunAsync<StockClosingDirectory, IReadOnlyList<DateOnly>>(d => d.GetCutDatesAsync());
    }

    private async Task CloseAsync()
    {
        var day = DateOnly.FromDateTime(date!.Value);
        var confirmed = await Dialogs.ShowMessageBoxAsync("ตัด STOCK", $"ตัด STOCK วัตถุดิบ ณ วันที่ {ThaiDate.Format(day)}? รายการถึงวันนั้นจะถูกปิดงวด และยกยอดคงเหลือมาเป็นยอดยกมา", yesText: "ตัด STOCK", cancelText: "ยกเลิก");
        if (confirmed != true) return;
        busy = true;
        try
        {
            result = await Services.RunAsync<StockClosingRegistry, StockClosingResult>(r => r.CloseAsync(day));
            foreach (var e in result.Errors) Snackbar.Add(e, Severity.Error);
            if (result.Succeeded) Snackbar.Add("ตัด STOCK แล้ว", Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
