@using Lockte.Purch
@* RPT-04 รายงานวัตถุดิบที่ยังไม่ได้รับ, ระดับ B on A4 นอน (UAT วัตถุดิบ 1, #421: the letters were too small on A4 ตั้ง because the supplier column made the whole table shrink; on a landscape page one item stays on one line at the full size): the order lines still waited for — ordered less received, not cancelled — by เลขที่ใบสั่งซื้อ → ที่. The quantity is ยอดค้างรับ. *@
@if (Lines.Count == 0)
{
    <NoData />
}
else
{
    <table>
        <thead>
            <tr><th>วันที่สั่งซื้อ</th><th>เลขที่ใบสั่งซื้อ</th><th class="num">ที่</th><th>ชื่อวัตถุดิบ</th><th class="num">ยอดค้างรับ</th><th>หน่วย</th><th>วันที่ต้องการ</th><th>ชื่อผู้ขาย / โทรฯ</th></tr>
        </thead>
        <tbody>
            @foreach (var line in Lines)
            {
                <tr>
                    <td>@ReportText.Date(line.OrderDate)</td>
                    <td>@line.OrderNo</td>
                    <td class="num">@line.LineNo</td>
                    <td>@line.MaterialName</td>
                    <td class="num">@ReportText.Decimal2(line.Outstanding)</td>
                    <td>@line.Unit</td>
                    <td>@(line.DesiredDate is { } d ? ReportText.Date(d) : null)</td>
                    <td>@line.SupplierName@(string.IsNullOrWhiteSpace(line.SupplierTel) ? "" : " · " + line.SupplierTel)</td>
                </tr>
            }
            <tr><td colspan="8" class="end"></td></tr>
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<OutstandingReceiptLine> Lines { get; set; } = [];
}
