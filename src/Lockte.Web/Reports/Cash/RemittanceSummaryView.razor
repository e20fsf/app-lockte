@using Lockte.SharedKernel
@* RPT-07 ใบสรุปยอดเงินขายของเก่าส่งสำนักงาน, ระดับ B on A4 ตั้ง: วันที่พิมพ์ (ยาว) ขวาบน, "ตั้งแต่เลขที่ … ถึงเลขที่ …" (the range closed), ลำดับ, เลขที่, จำนวนเงิน, รวมทั้งหมด. *@
<p style="text-align:right">วันที่ @Report.PrintedOn.ToString("d MMMM yyyy", ThaiDate.Culture)</p>
<p class="sub"><b>ตั้งแต่เลขที่ @Report.FromNo ถึงเลขที่ @Report.ToNo</b></p>
@if (Report.Rows.Count == 0)
{
    <NoData />
}
else
{
    <table>
        <colgroup><col style="width:15%" /><col style="width:45%" /><col style="width:40%" /></colgroup>
        <thead><tr><th class="num">ลำดับ</th><th>เลขที่</th><th class="num">จำนวนเงิน</th></tr></thead>
        <tbody>
            @for (var i = 0; i < Report.Rows.Count; i++)
            {
                <tr><td class="num">@(i + 1)</td><td>@Report.Rows[i].No</td><td class="num">@ReportText.Decimal2(Report.Rows[i].Total)</td></tr>
            }
            <tr><td></td><td><b>รวมทั้งหมด</b></td><td class="num"><b>@ReportText.Decimal2(Report.Total)</b></td></tr>
            <tr><td colspan="3" class="end"></td></tr>
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public Lockte.Web.Reports.Cash.RemittanceSummaryReport Report { get; set; } = null!;
}
