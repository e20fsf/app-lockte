@using Lockte.Hr
@* The two RPT-08 summaries on A4 ตั้ง (print-samples.md "แบบสรุป"), ระดับ B: (ลำดับ) แผนก จำนวนคน จำนวนเงิน, "รวมทั้งหมด" +
   เส้นคู่. สรุปบัญชีคำนวณค่าจ้าง (ปุ่ม "พิมพ์สรุป") prints Σ ค่าจ้าง (AMOUNT). (The legacy ต้นทุน variant, Σ (PAY_W + PAY_OT), was taken out in UAT-23.) The legacy put the print date top right and no company name; แบบกลาง B has both
   in its header and footer. Rows from PayHistoryReportDirectory.GetMonthEndSummaryAsync (BR-063). *@
<style>
    .big { font-size: 17pt; line-height: 1.25; }
    .big .sub { font-size: 17pt; margin-bottom: 8pt; }
    .big table th, .big table td { font-size: 17pt; padding-top: 1.5pt; padding-bottom: 1.5pt; }
    /* UAT-35: the double rule closes the table right under the รวมทั้งหมด row (the empty cell had a full line of its own) */
    .big table td.end { padding: 0; font-size: 0; line-height: 0; height: 2pt; }
    .big table tr.total td { padding-bottom: 0; }
</style>
<div class="big">
<p class="sub">ตั้งแต่วันที่ @ReportText.Date(Report.From)&emsp;ถึงวันที่ @ReportText.Date(Report.To)</p>
@if (Report.Lines.Count == 0)
{
    <NoData />
}
else
{
    var sum = Report.Sum;
    <table style="width:92%;margin:0 auto">
        <colgroup>
            <col style="width:10%" /><col style="width:45%" /><col style="width:20%" /><col style="width:25%" />
        </colgroup>
        <thead>
            <tr><th class="num"></th><th>แผนก</th><th class="num">จำนวนคน</th><th class="num">จำนวนเงิน</th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Report.Lines.Count; i++)
            {
                var line = Report.Lines[i];
                <tr>
                    <td class="num">@(i + 1)</td>
                    <td>@line.DepartmentName</td>
                    <td class="num">@line.Employees</td>
                    <td class="num">@ReportText.Decimal2(Amount(line))</td>
                </tr>
            }
            <tr class="total">
                <td></td>
                <td><b>รวมทั้งหมด</b></td>
                <td class="num"><b>@sum.Employees</b></td>
                <td class="num"><b>@ReportText.Decimal2(Amount(sum))</b></td>
            </tr>
            <tr><td></td><td colspan="3" class="end"></td></tr>
        </tbody>
    </table>
}
</div>

@code {
    [Parameter, EditorRequired] public MonthEndPaySummary Report { get; set; } = default!;

    /// <summary>The legacy heading: "สรุปบัญชีคำนวณค่าจ้างเดือน กันยายน 2569" (MOUNT = ถึงวันที่).</summary>
    public static string TitleOf(MonthEndPaySummary report) => "สรุปบัญชีคำนวณค่าจ้างเดือน " + MonthEndPayReportView.MonthOf(report.To);

    private static decimal Amount(MonthEndDepartmentTotal line) => line.Wages;
}
