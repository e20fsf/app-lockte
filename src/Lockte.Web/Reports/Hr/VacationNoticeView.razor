        new(907, 9524, 7599, "8.   เข้าทำงานเดือนสิงหาคม ได้หยุดเพิ่ม 2.5 วัน"),
        new(907, 9977, 7599, "9.   เข้าทำงานเดือนกันยายน ได้หยุดเพิ่ม 2.0 วัน"),
        new(802, 10431, 7704, "10.   เข้าทำงานเดือนตุลาคม ได้หยุดเพิ่ม 1.5 วัน"),
        new(802, 10885, 7704, "11.   เข้าทำงานเดือนพฤศจิกายน ได้หยุดเพิ่ม 1.0 วัน"),
        new(802, 11338, 7704, "12.   เข้าทำงานเดือนธันวาคม ได้หยุดเพิ่ม 0.5 วัน"),
        new(0, 11792, 8619, "ตามตัวอย่างข้างบนเริ่มทำงาน 18 พฤษภาคม 2561 ครบปีวันที่ 17 พฤษภาคม 2562 จะได้วันหยุดพัก"),
        new(0, 12245, 8619, "ผ่อนประจำปี 6 วันบวกอีก 4 วัน เป็น 10 วัน เนื่องจากเข้าทำงานเดือนพฤษภาคม"),
        new(4988, 13096, 3639, "ประกาศ ณ วันที่ 25 มิถุนายน 2562"),
    ];

    private static readonly Label Signer = new(5442, 14343, 3159, "");
    private static readonly Label SignerTitle = new(5839, 14795, 2739, "ผู้จัดการโรงงาน");

    private string SignerText => string.IsNullOrWhiteSpace(FactoryManagerName) ? "(" + new string(' ', 40) + ")" : $"({FactoryManagerName.Trim()})";

    /// <summary>The label's left edge, centre or right edge (its TextAlign) on the page, in mm.</summary>
    private static double X(Label l) => MarginLeft + l.Anchor switch
    {
        FormAnchor.Center => (l.Left + l.Width / 2.0) / TwipsPerMm,
        FormAnchor.Right => (l.Left + l.Width) / TwipsPerMm,
        _ => l.Left / TwipsPerMm,
    };

    /// <summary>The baseline: the label's top plus the font's ascent (Access puts the text at the top of the label).</summary>
    private static double Base(Label l) => MarginTop + l.Top / TwipsPerMm + 0.85 * l.Size * FormHtml.MillimetresPerPoint;
}
