@* RPT-04 ORDER ค้างส่งตามรุ่น (ORDERตามรุ่น), ระดับ B on A4 ตั้ง: (ลำดับ) รุ่น, จำนวน — the legacy had no unit and added every unit together;
   here a model's quantity is per unit and the "รวม" is per unit (D-11). *@
@if (Report.Filter is { } filter)
{
    <p class="sub">@filter</p>
}
@if (Report.Rows.Count == 0)
{
    <NoData />
}
else
{
    <table>
        <colgroup><col style="width:8%" /><col style="width:52%" /><col style="width:24%" /><col style="width:16%" /></colgroup>
        <thead><tr><th class="num">ที่</th><th>รุ่น</th><th class="num">จำนวน</th><th>หน่วย</th></tr></thead>
        <tbody>
            @for (var i = 0; i < Report.Rows.Count; i++)
            {
                var row = Report.Rows[i];
                <tr>
                    <td class="num">@(i + 1)</td>
                    <td>@row.Model</td>
                    <td class="num">@OrderReports.Qty(row.Quantity)</td>
                    <td>@row.Unit</td>
                </tr>
            }
            @foreach (var total in OrderReports.UnitTotals(Report.Rows.Select(r => (r.Unit, r.Quantity))))
            {
                <tr class="total">
                    <td></td><td><b>รวม</b></td>
                    <td class="num"><b>@OrderReports.Qty(total.Quantity)</b></td>
                    <td><b>@total.Unit</b></td>
                </tr>
            }
            <tr><td colspan="4" class="end"></td></tr>
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public BackorderByModelReport Report { get; set; } = null!;
}
