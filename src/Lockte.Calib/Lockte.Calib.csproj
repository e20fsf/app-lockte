<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lockte.SharedKernel\Lockte.SharedKernel.csproj" />
    <ProjectReference Include="..\Lockte.Org\Lockte.Org.csproj" />
    <!-- Public services only (SupplierDirectory, SupplierRegistry): บริษัทที่สอบเทียบ are suppliers of purch (ADR 0002). -->
    <ProjectReference Include="..\Lockte.Purch\Lockte.Purch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Starting data of the JIG inspection sheets (JigInspectionSeed); no names of people, technical values only. -->
    <EmbeddedResource Include="Seed\jig-inspection-sheets.tsv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
