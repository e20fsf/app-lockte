    // Legacy TextBox widths were not recovered: clip each item at the next item on the same line (Access clips too).
    IEnumerable<(double, double, string, double?)> Laid()
    {
        var items = Items().ToList();
        foreach (var (l, t, x) in items)
        {
            var next = items.Where(o => Math.Abs(o.Item2 - t) < 0.05 && o.Item1 > l).Select(o => o.Item1).DefaultIfEmpty(double.NaN).Min();
            yield return (l, t, x, double.IsNaN(next) ? null : next - l - 0.05);
        }
    }

    static string Style(double l, double t, double? w) =>
        $"left:{Cm(l)};top:{Cm(t)}" + (w.HasValue ? $";width:{Cm(w.Value)};overflow:hidden" : "");

    static string Cm(double v) => v.ToString("0.00", CultureInfo.InvariantCulture) + "cm";
