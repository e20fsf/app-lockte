@* PROTOTYPE — แบบ คร.2 (RPT-57). Positions (cm, left/top) copied from legacy report "แบบ คร2"
   (source/_extract/พนักงาน/legacy/reports/แบบ คร2.md). Company/manager text replaced with placeholders (public repo). *@
@using System.Globalization
<div class="kr2">
    @foreach (var (left, top, text, width) in Laid())
    {
        <div class="at" style="@Style(left, top, width)">@text</div>
    }
</div>

@code {
